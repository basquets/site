---
interface Props {
  num: string;
  title: string;
  copy: string;
}
const { num, title, copy } = Astro.props;
---
<div class="relative flex min-h-[300px] flex-col gap-3.5 border-r-2 border-b-2 border-divider px-7 pt-8 pb-7 hover:bg-surface">
  <span class="absolute top-5 right-6 font-heading font-extrabold text-[clamp(56px,5vw,84px)] leading-none text-accent-200 tnum">{num}</span>
  <h2 class="m-0 max-w-[9ch] text-2xl tracking-[-0.01em]">{title}</h2>
  <div class="my-1" aria-hidden="true"><slot /></div>
  <p class="mt-auto mb-0 text-[14.5px] leading-6 text-ink/78">{copy}</p>
</div>
