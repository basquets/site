---
interface Props {
  href: string;
  date: Date;
  title: string;
  description: string;
}
const { href, date, title, description } = Astro.props;
const formatted = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "UTC",
});
---
<a href={href} class="grid gap-x-8 gap-y-2 border-b-2 border-divider py-7 text-ink no-underline hover:bg-surface sm:grid-cols-[minmax(0,3fr)_minmax(0,7fr)]">
  <time datetime={date.toISOString().slice(0, 10)} class="text-[13px] uppercase tracking-[0.08em] text-ink/55 tnum">{formatted}</time>
  <span>
    <span class="block font-heading font-extrabold text-xl tracking-[-0.01em]">{title}</span>
    <span class="mt-1.5 block text-[14.5px] leading-6 text-ink/70">{description}</span>
  </span>
</a>
