---
interface Props {
  items: { value: string; label: string }[];
  class?: string;
}
const { items, class: className = "" } = Astro.props;
---
<dl class:list={["m-0 grid grid-cols-2 border-t-2 border-l-2 border-divider lg:grid-cols-4", className]}>
  {items.map((item) => (
    <div class="border-r-2 border-b-2 border-divider bg-surface px-6 py-5">
      <dt class="text-[11px] uppercase tracking-[0.1em] text-ink/55">{item.label}</dt>
      <dd class="m-0 mt-1.5 font-heading font-extrabold text-[clamp(26px,2.6vw,36px)] leading-none tracking-[-0.01em] tnum">{item.value}</dd>
    </div>
  ))}
</dl>
