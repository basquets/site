---
import Container from "./Container.astro";

interface Props {
  lines: string[];
  body?: string;
  id?: string;
}
const { lines, body, id } = Astro.props;
---
<section id={id} class="bg-accent text-ground">
  <Container class="py-[calc(3*28px)]">
    <h2 class="m-0 -ml-[0.058em] font-heading font-extrabold text-ground text-[clamp(34px,4.2vw,56px)] leading-[1.06] tracking-[-0.015em]">
      {lines.map((line) => <span class="block">{line}</span>)}
    </h2>
    {body && <p class="mt-7 mb-0 max-w-[52ch] text-base leading-7 text-ground">{body}</p>}
    <div class="mt-10 flex flex-wrap gap-3">
      <slot />
    </div>
  </Container>
</section>
