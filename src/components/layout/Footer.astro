---
import Container from "./Container.astro";

const links = [
  { href: "/baskets", label: "Baskets" },
  { href: "/stocks", label: "Stocks" },
  { href: "/swap", label: "Swap" },
  { href: "/curators", label: "Curators" },
  { href: "/learn", label: "How it works" },
  { href: "/docs", label: "Documentation" },
  { href: "/blog", label: "Blog" },
];

const socials = [
  {
    href: "https://x.com/basquetsxyz",
    label: "Twitter / X",
    path: "M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z",
  },
  {
    href: "https://github.com/basquets",
    label: "GitHub",
    path: "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12",
  },
];
---
<footer class="border-t-2 border-divider">
  <Container class="pt-[calc(2.5*28px)] pb-10">
    <p class="m-0 -ml-[0.058em] font-heading font-extrabold text-[clamp(40px,5.5vw,72px)] leading-[1.04] tracking-[-0.02em] text-ink">
      Draft the market.
    </p>
    <div class="mt-11 flex flex-wrap items-start justify-between gap-x-10 gap-y-6">
      <nav aria-label="Footer" class="flex flex-wrap gap-x-7 gap-y-2 text-[14px]">
        {links.map((l) => (
          <a href={l.href} class="text-ink no-underline hover:text-accent-700">{l.label}</a>
        ))}
      </nav>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-[14px]">
        {socials.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noreferrer"
            class="inline-flex items-center gap-2 text-ink no-underline hover:text-accent-700"
          >
            <svg viewBox="0 0 24 24" class="size-4 fill-current" aria-hidden="true"><path d={s.path} /></svg>
            {s.label}
          </a>
        ))}
      </div>
    </div>
    <div class="mt-12 flex flex-wrap items-end justify-between gap-x-10 gap-y-4 border-t-2 border-divider pt-6 text-[13px] leading-6 text-ink/70">
      <div>
        <span class="block">Basquets, the asset management layer of Robinhood Chain.</span>
        <span class="block">Baskets are not funds; nothing here is investment advice.</span>
      </div>
      <span class="tnum">© 2026 Basquets Protocol</span>
    </div>
  </Container>
</footer>
