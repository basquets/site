---
import WalletButton from "../islands/WalletButton.tsx";
import Container from "./Container.astro";

const links = [
  { href: "/baskets", label: "Baskets", match: "/baskets" },
  { href: "/stocks", label: "Stocks", match: "/stocks" },
  { href: "/swap", label: "Swap", match: "/swap" },
  // How it works and Documentation live in the footer — the navbar stays on
  // the three places you can act.
];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---
<nav class="border-b-2 border-divider">
  <Container class="flex flex-wrap items-center gap-x-4 gap-y-2 py-3">
    <a href="/" class="mr-auto inline-flex items-center gap-2 font-heading font-extrabold text-lg text-ink no-underline">
      <span class="inline-block size-3.5 bg-accent"></span>Basquets
    </a>
    {links.map((l) => (
      <a
        href={l.href}
        aria-current={l.match && (path === l.match || path.startsWith(`${l.match}/`)) ? "page" : undefined}
        class="font-heading text-[12.5px] font-extrabold text-ink uppercase tracking-[0.07em] no-underline whitespace-nowrap hover:text-accent-700 aria-[current=page]:text-accent-700"
      >{l.label}</a>
    ))}
    <WalletButton client:load />
  </Container>
</nav>
