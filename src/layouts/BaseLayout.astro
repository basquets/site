---
import "../styles/global.css";
import Analytics from "../components/Analytics.astro";

// Head-only shell (SEO/OG/favicon/fonts). The app chrome (nav, ticker, footer)
// moved to the app repo in the marketing/app split; every marketing surface
// brings its own chrome (ComingSoonLayout for the warm pages, DocsLayout /
// ArticleLayout for docs + blog).
interface Props {
  title: string;
  description: string;
  /** Keep gated preview pages out of search results. */
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
const orgLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Basquets",
  url: Astro.site?.toString(),
  logo: new URL("/favicon.svg", Astro.site).toString(),
  description:
    "Basquets turns tokenized US stocks on Robinhood Chain into baskets: portfolios anyone can create, invest in, and automate.",
});
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content="Basquets" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={orgLd} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <Analytics />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-accent focus:px-3.5 focus:py-2 focus:text-ground">Skip to content</a>
    <slot />
  </body>
</html>
