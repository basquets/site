---
import { type CollectionEntry, getCollection } from "astro:content";
import type { MarkdownHeading } from "astro";
import ComingSoonLayout from "./ComingSoonLayout.astro";

interface Props {
  entry: CollectionEntry<"docs">;
  headings: MarkdownHeading[];
}
const { entry, headings } = Astro.props;

const docs = (await getCollection("docs")).sort(
  (a, b) => a.data.order - b.data.order,
);
const items = docs.map((d) => ({
  id: d.id,
  href: d.id === "index" ? "/docs" : `/docs/${d.id}`,
  title: d.id === "index" ? "Overview" : d.data.title,
}));
const current = items.findIndex((i) => i.id === entry.id);
const prev = current > 0 ? items[current - 1] : undefined;
const next = current < items.length - 1 ? items[current + 1] : undefined;

// rehype-autolink-headings appends a literal "#" to each heading; strip it
// from the collected heading text before rendering the TOC.
const toc = headings
  .filter((h) => h.depth === 2)
  .map((h) => ({ ...h, text: h.text.replace(/\s*#\s*$/, "") }));
const pageTitle =
  entry.id === "index"
    ? "Docs - Basquets"
    : `${entry.data.title} - Basquets docs`;

const crumbs = [
  { name: "Docs", item: new URL("/docs", Astro.site).toString() },
  ...(entry.id === "index"
    ? []
    : [
        {
          name: entry.data.title,
          item: new URL(`/docs/${entry.id}`, Astro.site).toString(),
        },
      ]),
];
const docsLd = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: entry.data.title,
    description: entry.data.description,
    author: { "@type": "Organization", name: "Basquets" },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: crumbs.map((c, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: c.name,
      item: c.item,
    })),
  },
]);
---
<ComingSoonLayout title={pageTitle} description={entry.data.description} badges={false}>
  <script is:inline type="application/ld+json" set:html={docsLd} />
  <div class="cs-doc">
    <div class="cs-doc-grid">
      <aside class="cs-doc-aside">
        <nav aria-label="Protocol docs">
          <span class="cs-kicker">Protocol docs</span>
          <ol class="cs-doc-navlist">
            {items.map((item) => (
              <li>
                <a href={item.href} aria-current={item.id === entry.id ? "page" : undefined}>{item.title}</a>
              </li>
            ))}
          </ol>
        </nav>
        {toc.length > 1 && (
          <nav aria-label="On this page" class="cs-toc">
            <p class="cs-toc-h">On this page</p>
            <ol>
              {toc.map((h) => (
                <li><a href={`#${h.slug}`}>{h.text}</a></li>
              ))}
            </ol>
          </nav>
        )}
      </aside>

      <article>
        <div class="cs-prose">
          <slot />
        </div>

        <nav aria-label="Docs pagination" class="cs-doc-pager">
          {prev && (
            <a href={prev.href} class:list={[!next && "cs-pager-span2"]}>
              <span class="cs-pager-lbl">Previous</span>
              <span class="cs-pager-title">← {prev.title}</span>
            </a>
          )}
          {next && (
            <a href={next.href} class:list={[!prev && "cs-pager-span2"]}>
              <span class="cs-pager-lbl">Next</span>
              <span class="cs-pager-title">{next.title} →</span>
            </a>
          )}
        </nav>
      </article>
    </div>

    <slot name="bottom" />
  </div>
</ComingSoonLayout>
