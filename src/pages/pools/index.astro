---
import PoolsSummary from "../../components/islands/PoolsSummary";
import PoolsTable from "../../components/islands/PoolsTable";
import Container from "../../components/layout/Container.astro";
import Section from "../../components/layout/Section.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Pools - Basquets"
  description="Where the liquidity lives: every Uniswap v4 pool pairing a Robinhood stock token with USDG, grouped by stock, with real depth — dollars tradable before price moves 0.5% or 2%."
>
  <main id="main">
    <section class="slab relative overflow-hidden bg-ink pt-[calc(2.5*28px)] pb-[calc(2.5*28px)] text-ground">
      <Container class="relative z-10">
        <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-3">
          <span class="block text-[11px] uppercase tracking-[0.1em] text-accent-300">Liquidity</span>
          <span class="text-[11px] uppercase tracking-[0.1em] text-ground/60">Chain 4663 · Uniswap v4</span>
        </div>
        <h1 class="mt-4 mb-0 -ml-[0.058em] text-[clamp(38px,5vw,68px)] leading-[1.06] tracking-[-0.02em] text-ground">
          <span class="block">Where the liquidity</span>
          <span class="block">actually lives.</span>
        </h1>
        <p class="mt-8 mb-0 max-w-[56ch] text-[17px] leading-7 text-ground/70">
          Every Uniswap v4 pool pairing a stock token with USDG. Not vitrine TVL —
          real <span class="text-accent-300">depth</span>: how many dollars you can trade before the
          price moves half a percent, or two. Discovered from the PoolManager's logs, re-read every sync.
        </p>
        <h2 class="sr-only">Liquidity summary</h2>
        <div class="mt-12">
          <PoolsSummary client:load />
        </div>
      </Container>
    </section>

    <Container>
      <Section class="pt-[calc(2.5*28px)] pb-[calc(3*28px)]">
        <h2 class="sr-only">Pools by stock</h2>
        <PoolsTable client:load />
      </Section>
    </Container>
  </main>
</BaseLayout>
