---
import Portfolio from "../components/islands/Portfolio";
import Container from "../components/layout/Container.astro";
import Section from "../components/layout/Section.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Portfolio - Basquets"
  description="Your wallet's shelf on Robinhood Chain: USDG cash, every stock token you hold valued live, and your basket positions once baskets deploy."
  noindex
>
  <main id="main">
    <Container>
      <Section class="pt-[calc(2*28px)] pb-7">
        <h1 class="m-0 -ml-[0.058em] text-[clamp(38px,5vw,68px)] leading-[1.06] tracking-[-0.02em]">Portfolio.</h1>
        <p class="mt-5 mb-0 max-w-[52ch] text-[17px] leading-7">
          What this wallet holds, read straight from chain 4663 and valued at the same prices the
          protocol uses.
        </p>
      </Section>

      <Section class="pt-0 pb-[calc(3*28px)]">
        <h2 class="sr-only">Holdings</h2>
        <Portfolio client:load />
      </Section>
    </Container>
  </main>
</BaseLayout>
