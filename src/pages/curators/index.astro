---
import CuratorCalc from "../../components/islands/CuratorCalc";
import Container from "../../components/layout/Container.astro";
import Kicker from "../../components/layout/Kicker.astro";
import Section from "../../components/layout/Section.astro";
import { buttonVariants } from "../../components/ui/button";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { cn } from "../../lib/utils";

const SEATS_LEFT = 7;

const offer = [
  {
    stat: "60%",
    title: "Of every fee, from day one",
    copy: "You earn 60% of every fee your basket generates: 0.40% on each mint and each redeem, hard-capped in code. Paid onchain, claimable anytime. The holding fee ships at 0%, so you are paid when people move, not while they sit.",
  },
  {
    stat: "Day 1",
    title: "Landing-page placement",
    copy: "Genesis baskets are the launch. Your basket and name on the Basquets landing page, a permanent genesis badge, and co-marketing across our channels at launch.",
  },
  {
    stat: "+",
    title: "Reserved token allocation",
    copy: "If Basquets holds a token event, genesis curators have a reserved allocation. Being first is recognized permanently, not just at launch.",
  },
];

const audience = [
  {
    title: "Real stocks, not synthetics",
    copy: "Tokenized US equities with live prices via Robinhood Chain. Self-custodied: their basket sits in their wallet, not on an exchange.",
  },
  {
    title: "One tap, not twelve trades",
    copy: "A single zap from USDG mints the whole recipe. No brokerage account, no order forms, open 24/7 for transfers.",
  },
  {
    title: "A track record they can verify",
    copy: "Composition, fees, performance, every rebalance: all onchain. Your calls stop being screenshots and become a public record.",
  },
];
---
<BaseLayout
  title="Curators - Basquets"
  description="The genesis curator program: turn your portfolio into a product your audience can invest in with one tap, and earn 60% of every fee it generates."
>
  <main id="main">
    <Container>
      <Section class="pt-[calc(3*28px)] pb-[calc(2.5*28px)]">
        <Kicker class="mb-4">Genesis curator program · {SEATS_LEFT} of 10 seats open</Kicker>
        <h1 class="m-0 -ml-[0.058em] text-[clamp(42px,6vw,84px)] leading-[1.06] tracking-[-0.02em]">
          <span class="block">Your portfolio,</span>
          <span class="block">as a product.</span>
        </h1>
        <p class="mt-8 mb-0 max-w-[56ch] text-[clamp(17px,1.7vw,20px)] leading-[1.6]">
          You already tell people what you'd buy. Basquets turns that into a basket of real
          tokenized US stocks your audience can invest in with one tap, and pays you a share
          of every fee it generates.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="/connect?role=curator" class={cn(buttonVariants({ variant: "primary", size: "lg" }))}>Claim a genesis seat</a>
          <a href="#economics" class={cn(buttonVariants({ variant: "ghost", size: "lg" }))}>See the economics</a>
        </div>
      </Section>

      <Section rule>
        <h2 class="m-0 mb-7 text-[clamp(24px,2.6vw,32px)] tracking-[-0.015em]">The genesis offer.</h2>
        <div class="grid grid-cols-[repeat(auto-fit,minmax(260px,1fr))] gap-y-7 gap-x-[clamp(24px,4vw,56px)]">
          {offer.map((o) => (
            <div class="border-l-2 border-divider pl-5">
              <p class="m-0 font-heading font-extrabold text-[clamp(34px,3.4vw,48px)] text-accent tnum">{o.stat}</p>
              <p class="mt-2.5 mb-1.5 font-heading font-extrabold text-base">{o.title}</p>
              <p class="m-0 text-sm leading-[23px] text-ink/75">{o.copy}</p>
            </div>
          ))}
        </div>
      </Section>

      <Section rule id="economics">
        <h2 class="m-0 mb-7 text-[clamp(24px,2.6vw,32px)] tracking-[-0.015em]">What a basket pays.</h2>
        <CuratorCalc client:load />
      </Section>

      <Section rule>
        <h2 class="m-0 mb-7 text-[clamp(24px,2.6vw,32px)] tracking-[-0.015em]">The division of labor.</h2>
        <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,380px),1fr))] gap-y-7 gap-x-[clamp(32px,5vw,80px)]">
          <div>
            <h3 class="m-0 mb-4 text-[22px] tracking-[-0.01em]">You do two things</h3>
            <div class="grid gap-3.5 text-[15px] leading-[25px]">
              <p class="m-0"><strong>Design the basket.</strong> 3-20 tokenized US stocks and their weights. Your thesis, your name on it. Rebalance whenever you like; every change is public onchain.</p>
              <p class="m-0"><strong>Tell your audience.</strong> The thing you already do, except now the call has a ticker, a live NAV, and a one-tap way in.</p>
            </div>
          </div>
          <div>
            <h3 class="m-0 mb-4 text-[22px] tracking-[-0.01em]">We do the rest</h3>
            <div class="grid gap-3.5 text-[15px] leading-[25px]">
              <p class="m-0"><strong>Everything technical.</strong> Contracts, audits, listing, zap routing, pricing, custody rails on Robinhood Chain. You never touch code.</p>
              <p class="m-0"><strong>Launch marketing.</strong> Landing placement, announcement content, and a launch push across Basquets channels for every genesis basket.</p>
            </div>
          </div>
        </div>
      </Section>

      <Section rule>
        <h2 class="m-0 mb-7 text-[clamp(24px,2.6vw,32px)] tracking-[-0.015em]">Why your audience says yes.</h2>
        <div class="grid grid-cols-[repeat(auto-fit,minmax(250px,1fr))] gap-y-7 gap-x-[clamp(24px,4vw,56px)]">
          {audience.map((a) => (
            <div class="border-l-2 border-divider pl-5">
              <p class="m-0 mb-1.5 font-heading font-extrabold text-base">{a.title}</p>
              <p class="m-0 text-sm leading-[23px] text-ink/75">{a.copy}</p>
            </div>
          ))}
        </div>
      </Section>

      <Section rule id="apply" class="pb-[calc(3*28px)]">
        <div class="bg-accent p-[clamp(32px,5vw,64px)] text-ground">
          <p class="m-0 text-[12px] uppercase tracking-[0.1em] opacity-90">Genesis closes when the seats do</p>
          <h2 class="mt-3.5 mb-0 max-w-[20ch] font-heading font-extrabold text-[clamp(32px,4.4vw,60px)] text-ground leading-[1.08] tracking-[-0.02em]">
            {SEATS_LEFT} of 10 genesis seats remain. Launch is Q3 2026.
          </h2>
          <p class="mt-5.5 mb-0 max-w-[56ch] text-[15.5px] leading-[26px] opacity-95">
            Connect a wallet to claim a seat, or send us a rough list of stocks (or just a thesis)
            and we'll bring a draft basket, its fee math, and a launch plan to a 30-minute call.
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href="/connect?role=curator" class={cn(buttonVariants({ variant: "inverse" }), "bg-ground text-accent-800 hover:bg-accent-100 active:bg-accent-100")}>Connect wallet to claim</a>
            <a href="mailto:curators@basquets.xyz" class={cn(buttonVariants({ variant: "inverse" }))}>curators@basquets.xyz</a>
          </div>
        </div>
      </Section>
    </Container>
  </main>
</BaseLayout>
