---
import {
  CuratorHoldings,
  CuratorShelf,
  CuratorStats,
} from "../../components/islands/CuratorPanels";
import Container from "../../components/layout/Container.astro";
import CTABanner from "../../components/layout/CTABanner.astro";
import Section from "../../components/layout/Section.astro";
import { Badge } from "../../components/ui/badge";
import { buttonVariants } from "../../components/ui/button";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CURATORS, type CuratorProfile } from "../../lib/market";
import { cn } from "../../lib/utils";

export function getStaticPaths() {
  return CURATORS.map((profile) => ({
    params: { handle: profile.handle },
    props: { profile },
  }));
}

interface Props {
  profile: CuratorProfile;
}
const { profile } = Astro.props;
const initials = profile.name.replace("@", "").slice(0, 2).toUpperCase();
---
<BaseLayout
  title={`${profile.name} - Basquets`}
  description={`${profile.name} on Basquets. ${profile.bio}`}
>
  <main id="main">
    <Container>
      <Section class="pt-[calc(2*28px)] pb-[calc(2.5*28px)]">
        <a href="/baskets" class="text-[13px] uppercase tracking-[0.08em] text-accent-700 no-underline hover:underline">← Baskets</a>
        <div class="mt-10 flex flex-wrap items-start gap-[clamp(20px,3vw,42px)]">
          <span class="flex size-[clamp(84px,9vw,128px)] flex-none items-center justify-center bg-ink font-heading font-extrabold text-[clamp(30px,3.4vw,46px)] text-ground">{initials}</span>
          <div class="min-w-[280px] flex-1">
            <div class="flex flex-wrap items-baseline gap-3.5">
              <h1 class="m-0 text-[clamp(36px,4.4vw,60px)] leading-[1.06] tracking-[-0.02em]">{profile.name}</h1>
              {profile.curates.length > 0 && <Badge variant="accent">Curator</Badge>}
              <Badge variant="neutral">Investor</Badge>
            </div>
            <p class="mt-3.5 mb-0 max-w-[56ch] text-base leading-7 text-ink/78">{profile.bio}</p>
            <CuratorStats handle={profile.handle} client:load />
          </div>
        </div>
        <p class="mt-5 mb-0 text-[11px] text-ink/55">Sample profile for preview.</p>
      </Section>

      <Section rule class="pt-[calc(2.5*28px)] pb-[calc(3*28px)]">
        <h2 class="m-0 mb-7 text-[clamp(28px,3vw,40px)] tracking-[-0.015em]">What {profile.name} holds.</h2>
        <CuratorHoldings handle={profile.handle} client:load />
      </Section>

      {profile.curates.length > 0 && (
        <>
          <Section class="pt-0 pb-[calc(3*28px)]">
            <h2 class="m-0 mb-7 text-[clamp(28px,3vw,40px)] tracking-[-0.015em]">Baskets by {profile.name}.</h2>
            <CuratorShelf handle={profile.handle} client:load />
          </Section>

          <Section rule class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,420px),1fr))] items-start gap-y-10 gap-x-[clamp(24px,5vw,96px)] pt-[calc(2.5*28px)] pb-[calc(3*28px)]">
            <div>
              <h2 class="m-0 text-[32px] leading-[42px] tracking-[-0.015em]">Conviction pays.</h2>
              <p class="mt-5.5 mb-0 max-w-[48ch] text-[15.5px] leading-7 text-ink/78">
                Curators earn 60% of everything their basket generates in mint, redeem, and
                streaming fees, paid continuously, onchain, claimable anytime. No follower
                thresholds, no payout schedules, no invoicing anyone.
              </p>
            </div>
            <div class="flex flex-col text-[14.5px] leading-6">
              {[
                ["You set", "The recipe: exact components and units, permanent once published"],
                ["You earn", "60% of every fee your basket generates, claimable anytime"],
                ["You never", "Touch anyone's money. Investors self-custody, always"],
              ].map(([term, def], i) => (
                <div class:list={["flex gap-4 border-t-2 border-divider py-4", i === 2 && "border-b-2"]}>
                  <span class="min-w-[110px] font-heading font-extrabold">{term}</span>
                  <span class="text-ink/78">{def}</span>
                </div>
              ))}
            </div>
          </Section>
        </>
      )}
    </Container>

    <CTABanner
      lines={["Your group chat already", "thinks you're the analyst."]}
      body="Pick the tokens. Set the recipe. Publish. Your first basket takes minutes, and it earns from the first holder."
    >
      <a href="/curators" class={cn(buttonVariants({ variant: "inverse" }))}>Create a basket</a>
      <a href="/baskets" class={cn(buttonVariants({ variant: "inverse" }), "border-transparent")}>Explore baskets</a>
    </CTABanner>
  </main>
</BaseLayout>
