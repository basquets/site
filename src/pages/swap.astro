---
import SwapPanel from "../components/islands/SwapPanel";
import Container from "../components/layout/Container.astro";
import Section from "../components/layout/Section.astro";
import { buttonVariants } from "../components/ui/button";
import BaseLayout from "../layouts/BaseLayout.astro";
import { cn } from "../lib/utils";

const principles = [
  {
    num: "01",
    lead: "Quotes, not promises.",
    body: "Every number is a live quote from Uniswap v4 pools and 0x market makers, side by side. The better price wins.",
  },
  {
    num: "02",
    lead: "The gauge keeps you honest.",
    body: "The depth bar shows how much the pool can absorb before your own trade moves the price. Green means barely; red means split it up.",
  },
  {
    num: "03",
    lead: "Your minimum is enforced onchain.",
    body: "Review fixes a minimum you'll receive. If the market moves past your tolerance, the transaction cancels itself instead of filling worse.",
  },
  {
    num: "04",
    lead: "Stock-to-stock routes through USDG.",
    body: "There is no AAPL/NVDA pool. We sell into USDG and buy out of it in one transaction, and the breakdown prices both hops.",
  },
];
---
<BaseLayout
  title="Swap - Basquets"
  description="Swap USDG and tokenized stocks on Robinhood Chain with best-route execution across Uniswap v4 and 0x market makers, and no surprises."
>
  <main id="main">
    <Container>
      <!-- header: short, so the panel itself sits in the first viewport -->
      <Section class="pt-[calc(2*28px)] pb-7">
        <h1 class="m-0 -ml-[0.058em] text-[clamp(38px,5vw,68px)] leading-[1.06] tracking-[-0.02em]">Swap.</h1>
        <p class="mt-5 mb-0 max-w-[52ch] text-[17px] leading-7">
          USDG and tokenized stocks, traded directly onchain. Multiple venues quote every trade; the
          better price executes.
        </p>
      </Section>

      <Section class="pt-0 pb-[calc(2*28px)]">
        <h2 class="sr-only">Swap panel</h2>
        <SwapPanel client:load />
      </Section>

      <!-- the bridge to baskets, before the page lands on the ink plate -->
      <Section rule class="grid items-center gap-x-[clamp(32px,5vw,88px)] gap-y-9 pt-[calc(1.5*28px)] pb-[calc(2*28px)] lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]">
        <div>
          <h2 class="m-0 text-[clamp(26px,3vw,40px)] leading-[1.12] tracking-[-0.015em]">
            <span class="block">One stock is a trade.</span>
            <span class="block">Seven is a thesis.</span>
          </h2>
          <p class="mt-3.5 mb-0 max-w-[48ch] text-[15.5px] leading-7 text-ink/75">
            The same rails that fill a swap also fill a basket, one signature for the whole recipe.
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href="/baskets" class={cn(buttonVariants({ variant: "primary", size: "lg" }))}>Explore baskets</a>
          </div>
        </div>
        <!-- seven positions converging into one basket, in the house geometry -->
        <div class="hidden items-center justify-center gap-[clamp(16px,2.5vw,32px)] lg:flex" aria-hidden="true">
          <div class="grid grid-cols-4 items-center gap-2.5">
            <span class="size-5 border-2 border-ink"></span>
            <span class="size-5 bg-accent"></span>
            <span class="size-5 border-2 border-neutral-500"></span>
            <span class="size-5 bg-accent-300"></span>
            <span class="size-5 bg-accent-700"></span>
            <span class="size-5 border-2 border-ink"></span>
            <span class="size-5 bg-accent"></span>
            <span class="size-5 opacity-0"></span>
          </div>
          <span class="relative h-0.5 w-[clamp(40px,4vw,72px)] flex-none bg-ink">
            <span class="absolute -top-1 -right-px border-y-[5px] border-l-8 border-y-transparent border-l-ink"></span>
          </span>
          <span class="flex size-[104px] flex-none items-center justify-center border-2 border-ink bg-ground shadow-lg">
            <span class="grid grid-cols-3 gap-1.5">
              <span class="size-5 bg-accent"></span>
              <span class="size-5 bg-accent-300"></span>
              <span class="size-5 bg-accent"></span>
              <span class="size-5 bg-accent-700"></span>
              <span class="size-5 bg-accent"></span>
              <span class="size-5 bg-accent-300"></span>
              <span class="size-5 bg-accent"></span>
              <span class="size-5 opacity-0"></span>
              <span class="size-5 opacity-0"></span>
            </span>
          </span>
        </div>
      </Section>
    </Container>

    <!-- the four rules of the router, on the house ink plate: the page's closing word -->
    <section class="slab relative overflow-hidden bg-ink py-[calc(2.5*28px)] text-ground">
      <Container class="relative z-10">
        <h2 class="m-0 mb-10 max-w-[18ch] text-[clamp(26px,3vw,40px)] leading-[1.1] tracking-[-0.02em] text-ground">How swapping works.</h2>
        <div class="grid gap-x-[clamp(28px,3.5vw,56px)] gap-y-10 md:grid-cols-2 xl:grid-cols-4">
          {principles.map((p) => (
            <div class="border-t-2 border-accent-300/50 pt-5">
              <span class="font-heading font-extrabold text-[clamp(30px,2.4vw,38px)] leading-none text-accent-300 tnum" aria-hidden="true">{p.num}</span>
              <h3 class="mt-4 mb-0 max-w-[22ch] font-heading font-extrabold text-[17px] leading-6 tracking-[-0.01em] text-ground">{p.lead}</h3>
              <p class="mt-2.5 mb-0 max-w-[44ch] text-[14.5px] leading-6 text-ground/65">{p.body}</p>
            </div>
          ))}
        </div>
        <p class="mt-11 mb-0 max-w-[62ch] text-[13.5px] leading-6 text-ground/60">
          Fees are the pool's or the maker's trading fee plus network gas. Basquets adds nothing on
          top. Details in <a href="/docs/fees" class="text-accent-300">docs/fees</a>.
        </p>
      </Container>
    </section>
  </main>
</BaseLayout>
