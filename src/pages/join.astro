---
import WaitlistFlow from "../components/islands/WaitlistFlow";
import ComingSoonLayout from "../layouts/ComingSoonLayout.astro";

// Full-screen, centred waitlist sign-in — same header/footer as the rest of the
// coming-soon surface (via ComingSoonLayout). The WaitlistFlow island drives the
// real Privy login (Google, X, email, wallet) and registers the connected
// wallet via api-client joinWaitlist({ address }), reading its place back.
---
<ComingSoonLayout
  title="Basquets — Join the waitlist"
  description="Sign in to claim your spot on the Basquets waitlist. Onboarding the first curators and investors on Robinhood Chain."
  fullscreen
>
  <div class="cs-join">
    <div class="cs-join-inner">
      <span class="cs-tag">Early access</span>
      <h1 class="cs-display cs-display--sm">Get in <em>early.</em></h1>
      <p class="cs-sub">
        We're onboarding the first curators and investors. Sign in to claim your spot on the
        waitlist.
      </p>

      <WaitlistFlow client:load />

      <p class="cs-join-note">Secured by Privy · self-custodied · no seed phrase</p>
    </div>
  </div>
</ComingSoonLayout>
