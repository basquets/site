---
import ComingSoonLayout from "../layouts/ComingSoonLayout.astro";

// Full-screen, centred waitlist sign-in — same header/footer/ticker as the rest
// of the coming-soon surface (via ComingSoonLayout) for consistency. Presents the
// Privy login methods (Google, X, email, wallet). Buttons are the UI shell for
// now; the next pass wires them to Privy + api-client joinWaitlist({ address }).
---
<ComingSoonLayout
  title="Basquets — Join the waitlist"
  description="Sign in to claim your spot on the Basquets waitlist. Onboarding the first curators and investors on Robinhood Chain."
  fullscreen
>
  <div class="cs-join">
    <div class="cs-join-inner">
      <span class="cs-tag">Early access</span>
      <h1 class="cs-display cs-display--sm">Get in <em>early.</em></h1>
      <p class="cs-sub">
        We're onboarding the first curators and investors. Sign in to claim your spot on the
        waitlist.
      </p>

      <div class="cs-authlist">
        <button class="cs-authbtn" type="button" data-privy="google">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.4c-.3 1.5-1.1 2.7-2.4 3.6v3h3.9c2.3-2.1 3.6-5.2 3.6-8.8z"/><path fill="#34A853" d="M12 24c3.2 0 6-1.1 8-2.9l-3.9-3c-1.1.7-2.5 1.2-4.1 1.2-3.1 0-5.8-2.1-6.7-5H1.3v3.1C3.3 21.3 7.3 24 12 24z"/><path fill="#FBBC05" d="M5.3 14.3c-.2-.7-.4-1.5-.4-2.3s.1-1.6.4-2.3V6.6H1.3C.5 8.2 0 10 0 12s.5 3.8 1.3 5.4l4-3.1z"/><path fill="#EA4335" d="M12 4.8c1.8 0 3.3.6 4.6 1.8l3.4-3.4C18 1.2 15.2 0 12 0 7.3 0 3.3 2.7 1.3 6.6l4 3.1c.9-2.9 3.6-4.9 6.7-4.9z"/></svg>
          Continue with Google
        </button>
        <button class="cs-authbtn" type="button" data-privy="twitter">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 1.6h3.3l-7.2 8.2L23.7 22h-6.6l-5.2-6.8L5.9 22H2.6l7.7-8.8L2 1.6h6.8l4.7 6.2 5.4-6.2zm-1.2 18.4h1.8L7.1 3.4H5.2z"/></svg>
          Continue with X
        </button>
        <button class="cs-authbtn" type="button" data-privy="email">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg>
          Continue with email
        </button>

        <div class="cs-authdiv">or</div>

        <button class="cs-authbtn" type="button" data-privy="wallet">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h13a1 1 0 0 1 1 1v2"/><path d="M3 7v10a2 2 0 0 0 2 2h14a1 1 0 0 0 1-1v-3"/><path d="M21 12v3h-4a1.5 1.5 0 0 1 0-3z"/></svg>
          Connect a wallet
        </button>
      </div>

      <p class="cs-join-note">Secured by Privy · self-custodied · no seed phrase</p>
    </div>
  </div>
</ComingSoonLayout>
