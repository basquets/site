---
import { getCollection, render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";

const docs = (await getCollection("docs")).sort(
  (a, b) => a.data.order - b.data.order,
);
const overview = docs.find((d) => d.id === "index");
if (!overview) throw new Error("docs/index.mdx is missing");
const { Content, headings } = await render(overview);
const pages = docs.filter((d) => d.id !== "index");
---
<DocsLayout entry={overview} headings={headings}>
  <Content />

  <div slot="bottom">
    <hr class="cs-doc-divider" />
    <section>
      <h2 class="cs-doc-sub">All pages.</h2>
      <div class="cs-doc-cards">
        {pages.map((doc) => (
          <a href={`/docs/${doc.id}`} class="cs-doc-card">
            <span class="cs-doc-card-top">
              <span class="cs-doc-card-title">{doc.data.title}</span>
              <span class="cs-doc-card-arrow" aria-hidden="true">→</span>
            </span>
            <span class="cs-doc-card-desc">{doc.data.description}</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</DocsLayout>
