---
import BasketGrid from "../../components/islands/BasketGrid";
import RecipeRain from "../../components/islands/RecipeRain";
import Container from "../../components/layout/Container.astro";
import Kicker from "../../components/layout/Kicker.astro";
import Section from "../../components/layout/Section.astro";
import { buttonVariants } from "../../components/ui/button";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  ALL_BASKETS,
  COMPONENT_FLOAT_USD,
  FEED_SYMBOLS,
  HOUSE_TARGET_TVL_USD,
} from "../../lib/market";
import { CURATOR_SHARE_LABEL } from "../../lib/protocol";
import { TOKENS } from "../../lib/tokens";
import { cn } from "../../lib/utils";

// The catalog lists only what we actually intend to deploy. The other recipes in
// ALL_BASKETS are preview content and would read as inventory here.
const house = ALL_BASKETS.filter((b) => b.curatorHandle === "basquets");

const allowlisted = Object.keys(COMPONENT_FLOAT_USD).length;
const targetTvl = `$${(HOUSE_TARGET_TVL_USD / 1000).toFixed(0)}k`;

const rules = [
  {
    stat: `${FEED_SYMBOLS.length} of ${TOKENS.length}`,
    title: "Need a price feed",
    copy: `A component has to have a Chainlink feed on chain 4663: the registry requires one and the NAV oracle fails closed without it. That rules out ${TOKENS.length - FEED_SYMBOLS.length} of the stock tokens outright, however much you might want them.`,
  },
  {
    stat: `${allowlisted}`,
    title: "Have real depth behind them",
    copy: "Of the feed-backed tokens, this many have both enough onchain float and enough traded volume to sit at a meaningful weight today. The rest are not forbidden, just unproven, and we would rather say so than quietly include them.",
  },
  {
    stat: "15%",
    title: "Cap what one name can be",
    copy: `No component is weighted past the point where the basket would need to own more than 15% of everything that exists of it onchain. At our ${targetTvl} target that is a real constraint, and it is the reason some obvious recipes are not here.`,
  },
];
---
<BaseLayout
  title="Baskets - Basquets"
  description="The baskets Basquets curates at launch: live NAV, the exact recipe, and where every fee goes. Priced from the same Chainlink feeds the protocol mints against."
>
  <main id="main">
    <Container>
      <Section class="pt-[calc(3*28px)] pb-[calc(1.5*28px)]">
        <Kicker class="mb-4">Curated by Basquets</Kicker>
        <h1 class="m-0 -ml-[0.058em] text-[clamp(38px,5vw,68px)] leading-[1.06] tracking-[-0.02em]">
          <span class="block">{house.length} baskets,</span>
          <span class="block">and every unit in them.</span>
        </h1>
        <p class="mt-9 mb-0 max-w-[58ch] text-[17px] leading-7">
          A basket is one token holding a fixed recipe of real tokenized US stocks. These are the
          ones the protocol curates itself at launch, so nobody has to be the first person to
          deploy one. Nothing here is a model portfolio or a suggestion: each NAV is the recipe
          valued at the same Chainlink prices the protocol would mint it at, right now.
        </p>
      </Section>

      <Section class="pb-[calc(2.5*28px)]">
        <h2 class="sr-only">The launch lineup</h2>
        <BasketGrid symbols={house.map((b) => b.symbol)} minCol={340} client:load />
        <p class="mt-6 mb-0 max-w-[62ch] text-[14px] leading-6 text-ink/70">
          Every recipe is bounded by what its components' onchain float can absorb, and that
          arithmetic is <a href="/docs/how-baskets-work" class="text-accent-700">published
          alongside it</a> rather than asserted.
        </p>
      </Section>

      <Section rule class="pb-[calc(3*28px)]">
        <Kicker class="mb-3.5">The constraints</Kicker>
        <h2 class="m-0 mb-7 max-w-[24ch] text-[clamp(28px,3vw,40px)] tracking-[-0.015em]">
          Not every stock token can go in a basket.
        </h2>
        <div class="grid grid-cols-[repeat(auto-fit,minmax(260px,1fr))] gap-y-7 gap-x-[clamp(24px,4vw,56px)]">
          {rules.map((r) => (
            <div class="border-l-2 border-divider pl-5">
              <p class="m-0 font-heading font-extrabold text-[clamp(30px,3vw,44px)] text-accent tnum">{r.stat}</p>
              <p class="mt-2.5 mb-1.5 font-heading font-extrabold text-base">{r.title}</p>
              <p class="m-0 text-sm leading-[23px] text-ink/75">{r.copy}</p>
            </div>
          ))}
        </div>
        <p class="mt-7 mb-0 max-w-[62ch] text-[15px] leading-7 text-ink/78">
          The full list of what exists is on the <a href="/stocks" class="text-accent-700">stock token dashboard</a>,
          and the mechanics of recipes, minting and NAV are
          in <a href="/docs/how-baskets-work" class="text-accent-700">the docs</a>.
        </p>
      </Section>
    </Container>

    <!-- recipes drift behind the ask: the weights are the story, so the
         backdrop is made of them -->
    <section class="relative overflow-hidden bg-accent text-ground">
      <RecipeRain client:idle />
      <Container class="relative z-10 py-[calc(3.5*28px)]">
        <h2 class="m-0 -ml-[0.058em] font-heading font-extrabold text-ground text-[clamp(34px,4.2vw,56px)] leading-[1.06] tracking-[-0.015em]">
          <span class="block">Nothing here is your thesis.</span>
          <span class="block">Publish yours.</span>
        </h2>
        <p class="mt-6 mb-0 max-w-[52ch] text-base leading-7 text-ground/85">
          A recipe is an argument. The protocol gives it a price, a token anyone can hold, and
          {CURATOR_SHARE_LABEL} of every fee it earns.
        </p>
        <div class="mt-10 flex flex-wrap gap-3">
          <a href="/create" class={cn(buttonVariants({ variant: "inverse", size: "lg" }))}>Create a basket</a>
          <a href="/curators" class={cn(buttonVariants({ variant: "inverse", size: "lg" }), "border-transparent")}>Become a curator</a>
        </div>
      </Container>
    </section>
  </main>
</BaseLayout>
