---
import { getCollection } from "astro:content";
import ComingSoonLayout from "../../layouts/ComingSoonLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  });
---
<ComingSoonLayout title="Blog - Basquets" description="Protocol design, curator stories, and launch updates from Basquets." badges={false}>
  <section class="cs-doc">
    <span class="cs-kicker">Blog</span>
    <h1 class="cs-doc-title">Notes from the studio.</h1>
    <div class="cs-blog-list">
      {posts.map((post) => (
        <a href={`/blog/${post.id}`} class="cs-blog-row">
          <span class="cs-blog-date">{fmt(post.data.date)}</span>
          <span>
            <h2 class="cs-blog-row-title">{post.data.title}</h2>
            <p class="cs-blog-row-desc">{post.data.description}</p>
          </span>
        </a>
      ))}
    </div>
  </section>
</ComingSoonLayout>
