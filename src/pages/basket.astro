---
import ComingSoonLayout from "../layouts/ComingSoonLayout.astro";

// Genesis — one pinned cover that transforms on scroll. At rest: the jade token
// (the basket) with its seven holdings orbiting it. On scroll the seven leave
// their orbits, settle into a row of cards, then funnel down through lines into
// the token — which reveals its bGEN value — and the stats land. GSAP +
// ScrollTrigger drive the scrub; a static fallback covers mobile / reduced
// motion. Numbers are PLACEHOLDER until the live Chainlink island lands.

const genesis = [
  { sym: "NVDA", name: "NVIDIA", kind: "stock", px: "181.20", chg: 4.1 },
  { sym: "AAPL", name: "Apple", kind: "stock", px: "232.60", chg: 1.2 },
  { sym: "BTC", name: "Bitcoin", kind: "crypto", px: "95,240", chg: 2.6 },
  { sym: "MSFT", name: "Microsoft", kind: "stock", px: "441.10", chg: 0.9 },
  { sym: "ETH", name: "Ethereum", kind: "crypto", px: "3,410", chg: 5.4 },
  { sym: "AMZN", name: "Amazon", kind: "stock", px: "233.90", chg: 2.2 },
  { sym: "LINK", name: "Chainlink", kind: "crypto", px: "24.80", chg: 6.3 },
];

// Most stock logos are colour PNGs; a few brand marks ship as monochrome SVGs
// (the PNG set had them white-on-transparent, invisible on the light tile).
const stockSvg = new Set(["AAPL", "INTC", "AMZN"]);
const logoSrc = (c: { sym: string; kind: string }) =>
  c.kind === "crypto"
    ? `/logos/crypto/${c.sym.toLowerCase()}.svg`
    : `/logos/stock/${c.sym}.${stockSvg.has(c.sym) ? "svg" : "png"}`;

// Per-holding orbit: each circles the token like a planet — its own radius (rf,
// a factor on a shared base), speed (dur) and start phase (ph). Round circles,
// no tilt, so the badges read as bodies orbiting the basket.
// Radii + phases spread evenly around the circle (and speeds kept distinct) so no
// two badges share an orbit band or clump together as they circle.
const orbits = [
  { rf: 0.72, dur: 40, ph: 0.0 }, // NVDA
  { rf: 1.3, dur: 58, ph: 0.14 }, // AAPL
  { rf: 0.95, dur: 46, ph: 0.28 }, // BTC
  { rf: 1.15, dur: 64, ph: 0.42 }, // MSFT
  { rf: 0.82, dur: 38, ph: 0.57 }, // ETH
  { rf: 1.42, dur: 70, ph: 0.71 }, // AMZN
  { rf: 1.05, dur: 52, ph: 0.85 }, // LINK
];
---
<ComingSoonLayout
  title="Basquets — Genesis basket"
  description="Genesis: the first Basquets basket — the biggest names in stocks and crypto on Robinhood Chain, drafted into one, priced live by Chainlink."
  badges={false}
>
  <div class="gs" data-gs-root>
    <!-- the scroll track: tall, so the pinned cover has room to play out -->
    <div class="gs-scene" data-gs-scene>
      <section class="gs-pin" data-gs-pin>
        <!-- header: the tag + title fade out on scroll; the thesis line stays on top -->
        <div class="gs-hero-top">
          <div class="gs-hero-fade" data-gs-fade>
            <span class="cs-tag">The flagship basket · curated by Basquets</span>
            <h1 class="cs-display gs-title">Genesis.</h1>
          </div>
          <p class="gs-heroline">Incumbents and insurgents, in one self-custodied token.</p>
        </div>

        <!-- the jade token = the basket (bGEN). The holdings orbit it, then funnel in -->
        <div class="gs-planet" data-gs-planet>
          <span class="gs-hero-glow" aria-hidden="true"></span>
          <img class="gs-hero-art" src="/genesis-token.webp" alt="" width="1500" height="1137" aria-hidden="true" />
        </div>

        <!-- the seven holdings: orbit at rest (each on its own tilted ellipse via a
             JS-built offset-path), settle into a card row on scroll -->
        <div class="gs-orbit" data-gs-orbit>
          {genesis.map((c, i) => (
            <span
              class="gs-orbit-chip"
              data-gs-chip
              data-i={i}
              data-sym={c.sym}
              style={`--dur:${orbits[i].dur}s;--ph:${orbits[i].ph};--rf:${orbits[i].rf}`}
            >
              <span class="gs-orbit-chip-in">
                <span class="gs-chip-top">
                  <i class="gs-orbit-logo"><img src={logoSrc(c)} alt="" width="18" height="18" /></i>
                  <b class="gs-chip-sym">{c.sym}</b>
                </span>
                <span class="gs-chip-extra" data-gs-extra>
                  <span class="gs-chip-name">{c.name}</span>
                  <span class="gs-chip-foot">
                    <span class="gs-chip-px">${c.px}</span>
                    <span class={`gs-chip-chg ${c.chg >= 0 ? "cs-up" : "cs-down"}`}>
                      {c.chg >= 0 ? "▲" : "▼"} {Math.abs(c.chg)}%
                    </span>
                  </span>
                </span>
              </span>
            </span>
          ))}
        </div>

        <!-- funnel lines the seven draw down into the token (paths built in JS) -->
        <svg class="gs-lines" data-gs-lines aria-hidden="true"></svg>

        <!-- the token's minted value, revealed as the lines arrive into it -->
        <div class="gs-bgen" data-gs-bgen>
          <div class="gs-bgen-card">
            <span class="gs-bgen-mark" aria-hidden="true"><img src="/genesis-token.webp" alt="" width="1500" height="1137" /></span>
            <span class="gs-bgen-id">
              <span class="gs-bgen-sym">bGEN</span>
              <span class="gs-bgen-name">Genesis · basket token</span>
            </span>
            <span class="gs-bgen-val">
              <span class="gs-bgen-px">$103.60</span>
              <span class="cs-return-val cs-up gs-bgen-chg">+3.6%</span>
            </span>
          </div>
        </div>

        <span class="gs-scrolldown" data-gs-scroll>Scroll down ↓</span>
      </section>
    </div>

    <!-- ACT close — CTA. The funnel line continues down and draws a rounded border
         around this card as it scrolls in; the content fades in behind it. -->
    <section class="gs-cta" data-gs-cta>
      <div class="gs-cta-card" data-gs-cta-card>
        <svg class="gs-cta-frame" data-gs-cta-frame aria-hidden="true" preserveAspectRatio="none">
          <path data-gs-cta-path></path>
        </svg>
        <div class="gs-cta-inner" data-gs-cta-inner>
          <span class="cs-tag">Early access</span>
          <h2 class="cs-display cs-display--sm">Own Genesis in <em>one signature.</em></h2>
          <p class="gs-cta-sub">
            Priced live by Chainlink, self-custodied, yours. Join the waitlist to draft baskets
            before anyone else.
          </p>
          <div class="cs-cta-row" style="justify-content:center;">
            <a href="/join" class="cs-pill cs-pill--ink cs-pill--lg">Join the waitlist</a>
            <a href="/docs" class="cs-pill cs-pill--ghost cs-pill--lg">Learn more →</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</ComingSoonLayout>

<style>
  /* the pinned cover fills one viewport; the scene above it is the scroll track */
  .gs-scene { position: relative; height: 300vh; }
  .gs-pin { position: relative; height: calc(100dvh - 84px); min-height: 640px; overflow: hidden; }

  /* title + thesis, top-centred */
  .gs-hero-top {
    position: absolute; left: 50%; top: clamp(28px, 6vh, 72px); transform: translateX(-50%);
    width: min(720px, 90vw); text-align: center; z-index: 4;
  }
  .gs-title { margin: 12px 0 0; font-size: clamp(56px, 10vw, 128px); }
  .gs-heroline {
    margin: 18px auto 0; font-family: var(--serif); font-style: italic; font-weight: 400;
    font-size: clamp(17px, 1.9vw, 24px); color: var(--ink-70); white-space: nowrap;
  }

  /* the jade token, centred — parallax (--px/--py inherited from the pin) + float.
     A real orbit: each badge's z-index flips with its depth (JS), so badges on the
     far half ride fully behind the planet and the near half fully in front. */
  .gs-planet {
    position: absolute; top: 53%; left: 50%; z-index: 2;
    width: min(62vh, 575px); max-width: 92vw; pointer-events: none;
    transform: translate(calc(-50% + var(--px, 0px)), calc(-50% + var(--py, 0px)));
  }
  .gs-hero-art {
    display: block; width: 100%; height: auto;
    filter: drop-shadow(0 26px 46px rgba(28, 44, 26, 0.22));
    animation: gs-artfloat 15s ease-in-out infinite;
  }
  @keyframes gs-artfloat {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-14px) rotate(0.8deg); }
  }
  .gs-hero-glow {
    position: absolute; left: 50%; top: 52%; width: 74%; height: 74%;
    transform: translate(-50%, -50%); border-radius: 50%;
    background: radial-gradient(circle, color-mix(in oklch, var(--accent) 40%, transparent) 0%, transparent 66%);
    filter: blur(40px); z-index: -1;
    animation: gs-artglow 7s ease-in-out infinite;
  }
  @keyframes gs-artglow {
    0%, 100% { opacity: 0.45; transform: translate(-50%, -50%) scale(0.92); }
    50% { opacity: 0.78; transform: translate(-50%, -50%) scale(1.08); }
  }

  /* the orbit box fills the pin (no z-index of its own, so each badge can stack
     independently against the planet for the behind/in-front depth effect) */
  .gs-orbit { position: absolute; inset: 0; pointer-events: none; }
  /* each badge circles the token on its own round orbit (rf scales a base radius);
     no tilt, so GSAP can later translate it to a row slot in plain screen space.
     z-index defaults to in-front (3); the depth loop drops it to 1 on the far half. */
  .gs-orbit-chip {
    --base: min(32vh, 280px);
    position: absolute; left: 0; top: 0; z-index: 3;
    offset-path: circle(calc(var(--rf) * var(--base)) at 50% 53%);
    offset-rotate: 0deg;
    offset-distance: calc(var(--ph) * 100%);
    animation: gs-orbit var(--dur) linear infinite;
  }
  @keyframes gs-orbit { to { offset-distance: calc(var(--ph) * 100% + 100%); } }
  /* the badge itself — a tight glass pill (logo + ticker) at rest; on settle the
     detail caption below it fades in, so the pill stays tight and never reflows. */
  .gs-orbit-chip-in {
    position: relative;
    display: inline-flex; align-items: center; gap: 6px;
    padding: 4px 11px 4px 5px; border-radius: 999px;
    background: color-mix(in oklch, var(--cream) 74%, transparent);
    border: 1px solid color-mix(in oklch, var(--ink) 9%, transparent);
    backdrop-filter: blur(9px); -webkit-backdrop-filter: blur(9px);
    box-shadow: 0 6px 18px rgba(30, 34, 22, 0.12);
    font-weight: 700; font-size: 13px; letter-spacing: -0.01em; color: var(--ink); white-space: nowrap;
  }
  .gs-chip-top { display: inline-flex; align-items: center; gap: 6px; }
  .gs-orbit-logo {
    display: inline-flex; align-items: center; justify-content: center;
    width: 22px; height: 22px; background: #fff; border-radius: 6px; flex: none;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.05);
  }
  .gs-orbit-logo img { width: 16px; height: 16px; display: block; object-fit: contain; }
  /* detail caption — absolute below the pill, so revealing it never widens the pill */
  .gs-chip-extra {
    position: absolute; top: calc(100% + 7px); left: 50%;
    display: flex; flex-direction: column; align-items: center; gap: 3px;
    opacity: 0; white-space: nowrap; pointer-events: none;
  }
  .gs-chip-name { font-size: 11.5px; font-weight: 500; color: var(--ink-55); }
  .gs-chip-foot { display: flex; align-items: center; gap: 8px; }
  .gs-chip-px { font-size: 13px; font-weight: 600; font-variant-numeric: tabular-nums; }
  .gs-chip-chg { font-size: 11px; font-weight: 700; font-variant-numeric: tabular-nums; padding: 2px 7px; border-radius: 999px; }
  .gs-chip-chg.cs-up { background: color-mix(in srgb, var(--accent) 15%, transparent); color: var(--accent-deep); }
  .gs-chip-chg.cs-down { background: color-mix(in srgb, var(--down) 13%, transparent); color: var(--down); }

  /* the funnel lines (paths created in JS lack Astro's scope attribute) */
  /* z-index 0 — below the planet (1), so the funnel lines pass behind the token */
  .gs-lines { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0; overflow: visible; }
  :global(.gs-line) { fill: none; stroke: var(--accent); stroke-width: 1.5; opacity: 0.55; stroke-linecap: round; }

  /* the minted bGEN token, a card that fades in as the lines arrive into it */
  .gs-bgen {
    position: absolute; left: 50%; top: auto; bottom: clamp(18px, 4vh, 48px); transform: translateX(-50%);
    opacity: 0; z-index: 4;
  }
  .gs-bgen-card {
    display: inline-flex; align-items: center; gap: 14px;
    padding: 13px 22px 13px 13px; border-radius: 18px;
    background:
      radial-gradient(130% 130% at 18% 0%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 62%),
      color-mix(in srgb, #fff 82%, var(--sand-2));
    border: 1px solid color-mix(in srgb, var(--accent) 42%, transparent);
    box-shadow: 0 14px 34px -20px color-mix(in srgb, var(--accent) 46%, transparent);
  }
  .gs-bgen-mark { width: 46px; height: 46px; flex: none; display: grid; place-items: center; }
  .gs-bgen-mark img { width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 4px 8px rgba(28, 44, 26, 0.28)); }
  .gs-bgen-id { display: flex; flex-direction: column; align-items: flex-start; }
  .gs-bgen-sym { font-weight: 700; font-size: 18px; letter-spacing: 0.01em; }
  .gs-bgen-name { font-size: 12px; color: var(--ink-55); }
  .gs-bgen-val { display: flex; flex-direction: column; align-items: flex-end; margin-left: 10px; }
  .gs-bgen-px { font-family: var(--serif); font-size: clamp(23px, 2.6vw, 30px); font-weight: 500; letter-spacing: -0.01em; font-variant-numeric: tabular-nums; }
  .gs-bgen-chg { font-size: 14px; }

  /* scroll hint */
  .gs-scrolldown { position: absolute; bottom: clamp(20px, 4vh, 40px); left: 50%; transform: translateX(-50%); font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-55); opacity: 0.7; z-index: 5; animation: gs-bob 2.4s ease-in-out infinite; }
  @keyframes gs-bob { 0%, 100% { transform: translateX(-50%) translateY(0); } 50% { transform: translateX(-50%) translateY(5px); } }

  @media (prefers-reduced-motion: reduce) {
    .gs-hero-art, .gs-hero-glow, .gs-orbit-chip { animation: none; }
  }

  /* CTA — a card the funnel line wraps as it scrolls in. The extra bottom space
     gives the border-draw room to finish before the footer. */
  .gs-cta { max-width: 760px; margin: 0 auto clamp(24px, 6vh, 72px); padding: clamp(2px, 1vh, 14px) clamp(20px, 5vw, 48px) 0; text-align: center; }
  .gs-cta-card { position: relative; padding: clamp(30px, 5vh, 54px) clamp(24px, 5vw, 52px); border-radius: 28px; }
  .gs-cta-frame { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; z-index: 0; }
  .gs-cta-frame path { fill: none; stroke: var(--accent); stroke-width: 1.5; opacity: 0.6; stroke-linecap: round; stroke-linejoin: round; }
  .gs-cta-inner { position: relative; z-index: 1; }
  .gs-cta .cs-display { margin: 14px 0 0; font-size: clamp(27px, 4.4vw, 47px); white-space: nowrap; }
  .gs-cta-sub { max-width: 46ch; margin: 16px auto 30px; font-size: clamp(15px, 1.3vw, 18px); line-height: 1.6; color: var(--ink-70); }
  @media (max-width: 640px) {
    .gs-cta .cs-display { white-space: normal; font-size: clamp(26px, 7vw, 34px); }
  }
  /* static: a plain bordered card, no drawn frame */
  .gs--static .gs-cta-frame { display: none; }
  .gs--static .gs-cta-card { border: 1px solid var(--line); }

  /* static fallback (mobile / reduced motion): a plain, readable stack */
  .gs--static .gs-scene { height: auto; }
  .gs--static .gs-pin { height: auto; min-height: 0; overflow: visible; padding: clamp(28px, 6vh, 56px) clamp(20px, 5vw, 40px) 40px; display: flex; flex-direction: column; align-items: center; gap: 26px; }
  .gs--static .gs-hero-top { position: static; transform: none; }
  .gs--static .gs-heroline { white-space: normal; }
  .gs--static .gs-planet { position: static; transform: none; width: min(300px, 68vw); }
  .gs--static .gs-lines, .gs--static .gs-scrolldown { display: none; }
  /* holdings become a plain wrapped row of pills with their detail shown */
  .gs--static .gs-orbit { position: static; inset: auto; display: flex; flex-wrap: wrap; justify-content: center; gap: 12px 14px; margin-top: 4px; }
  .gs--static .gs-orbit-chip { position: static; offset-path: none; animation: none; }
  .gs--static .gs-orbit-chip-in { margin: 0; }
  .gs--static .gs-chip-extra { position: static; opacity: 1; transform: none; margin-top: 6px; }
  .gs--static .gs-bgen { position: static; transform: none; opacity: 1; }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const root = document.querySelector("[data-gs-root]") as HTMLElement | null;
  if (root) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const small = window.matchMedia("(max-width: 820px)").matches;
    const force = /[?&]motion=1/.test(location.search); // dev override for reduced-motion previews

    if ((reduce || small) && !force) {
      root.classList.add("gs--static");
    } else {
      const scene = root.querySelector("[data-gs-scene]") as HTMLElement;
      const pin = root.querySelector("[data-gs-pin]") as HTMLElement;
      const fade = root.querySelector("[data-gs-fade]") as HTMLElement;
      const heroline = root.querySelector(".gs-heroline") as HTMLElement;
      const planet = root.querySelector("[data-gs-planet]") as HTMLElement;
      const linesSvg = root.querySelector("[data-gs-lines]") as SVGSVGElement;
      const bgen = root.querySelector("[data-gs-bgen]") as HTMLElement;
      const scrollCue = root.querySelector("[data-gs-scroll]") as HTMLElement;
      const chips = gsap.utils.toArray<HTMLElement>("[data-gs-chip]");

      const ROW_Y = 0.24; // vertical centre of the settled card row (fraction of the pin)
      const GAP = 14;
      let fitScale = 1;
      let heroRise = 0;
      const linePaths: SVGPathElement[] = [];
      for (let i = 0; i < chips.length; i++) {
        const p = document.createElementNS("http://www.w3.org/2000/svg", "path");
        p.setAttribute("class", "gs-line");
        linesSvg.appendChild(p);
        linePaths.push(p);
      }

      // Freeze the orbits and lock every measured target exactly once, the first
      // time the pin engages — measuring again later (on re-enter / refresh) would
      // read already-transformed chips and corrupt the reverse scrub.
      let frozen = false;
      // Resume the live orbit when the pin is scrolled back off the top, so the
      // badges circle again instead of staying stuck at their frozen positions.
      function unfreeze() {
        frozen = false;
        (root as HTMLElement).classList.remove("gs--frozen");
      }
      function freeze() {
        if (frozen) return;
        frozen = true;
        (root as HTMLElement).classList.add("gs--frozen"); // pauses the CSS orbit animation
        // pin is the (fixed) reference; slots + lines are computed in its space
        const pr = pin.getBoundingClientRect();
        const planetR = planet.getBoundingClientRect();

        const cardW = 118; // pill + its caption footprint
        const natural = chips.length * cardW + (chips.length - 1) * GAP;
        fitScale = Math.min(1, (pr.width * 0.9) / natural);
        const spacing = (cardW + GAP) * fitScale;
        const total = chips.length * spacing - GAP * fitScale;
        const startX = pr.left + pr.width / 2 - total / 2 + (cardW * fitScale) / 2;
        const rowY = pr.top + pr.height * ROW_Y;
        heroRise = (fade ? fade.offsetHeight : 120) * 0.82; // how far the thesis line climbs

        // funnel routes card → through the token's centre → down into bGEN, so the
        // seven merge behind the planet into one strand that becomes the token (all
        // pin-local coords for the SVG). The mid section is hidden behind the planet.
        const planetMidY = planetR.top + planetR.height * 0.5 - pr.top;
        // converge on the bGEN card's true centre (measured) so the strand lines up
        // with the card and the CTA connector below — not the parallax-shifted planet
        const bgenR = bgen.getBoundingClientRect();
        const bxL = bgenR.left + bgenR.width / 2 - pr.left;
        const bgenY = bgenR.top + bgenR.height * 0.4 - pr.top;
        const rowYL = pr.height * ROW_Y;

        chips.forEach((chip, i) => {
          const r = chip.getBoundingClientRect();
          const cx0 = r.left + r.width / 2;
          const cy0 = r.top + r.height / 2;
          const slotX = startX + i * spacing;
          // circular orbits (no tilt) → the travel delta is plain screen space
          (chip as any)._tx = slotX - cx0;
          (chip as any)._ty = rowY - cy0;
          chip.style.zIndex = "3"; // settled cards sit in front of the token
          // funnel line: card underside → planet centre → bGEN (pin-local)
          const slotXL = slotX - pr.left;
          const startLineY = rowYL + 42 * fitScale;
          const p = linePaths[i];
          // card → through the token → down behind the card to the pin's foot, so a
          // single centred strand emerges from under the card toward the CTA
          p.setAttribute("d", `M ${slotXL} ${startLineY} C ${slotXL} ${startLineY + 120}, ${bxL} ${planetMidY}, ${bxL} ${bgenY} L ${bxL} ${pr.height}`);
          const len = p.getTotalLength();
          p.style.strokeDasharray = `${len}`;
          p.style.strokeDashoffset = `${len}`;
        });
        linesSvg.setAttribute("viewBox", `0 0 ${pr.width} ${pr.height}`);
        tl.invalidate();
      }

      // Real-orbit depth: while circling (not settling), a badge above the planet's
      // centre line rides fully behind it (z 1), below rides fully in front (z 3).
      // Whole-badge — no seam — and the flip lands at the planet's side edge.
      function depthTick() {
        if (!frozen) {
          const pc = planet.getBoundingClientRect();
          const midY = pc.top + pc.height * 0.5;
          for (const chip of chips) {
            const r = chip.getBoundingClientRect();
            chip.style.zIndex = r.top + r.height / 2 < midY ? "1" : "3";
          }
        }
        requestAnimationFrame(depthTick);
      }
      requestAnimationFrame(depthTick);

      const extras = chips.map((c) => c.querySelector("[data-gs-extra]") as HTMLElement);
      gsap.set(bgen, { xPercent: -50 });
      gsap.set(extras, { xPercent: -50, y: 6 }); // caption centred under its pill

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: scene,
          start: "top top",
          end: "bottom bottom",
          scrub: 0.8,
          pin: pin,
          anticipatePin: 1,
          invalidateOnRefresh: true,
          onEnter: freeze,
          onEnterBack: freeze,
          onLeaveBack: unfreeze,
        },
      });

      // 1 — tag + title fade; the thesis line rises to the top and stays; cue clears
      tl.to(fade, { opacity: 0, y: -20, duration: 0.5, ease: "power2.in" }, 0);
      tl.to(heroline, { y: () => -heroRise, duration: 0.7, ease: "power2.inOut" }, 0);
      tl.to(scrollCue, { opacity: 0, duration: 0.4 }, 0);
      // 2 — the seven leave their orbits and settle into the row
      tl.to(chips, { x: (i, t) => (t as any)._tx, y: (i, t) => (t as any)._ty, duration: 1.2, ease: "power2.inOut", stagger: 0.04 }, 0.1);
      // 3 — each pill reveals its detail caption
      tl.to(extras, { opacity: 1, y: 0, duration: 0.6, ease: "power1.out", stagger: 0.04 }, 0.7);
      // 4 — the lines funnel down behind the token
      tl.to(linePaths, { strokeDashoffset: 0, duration: 0.7, ease: "power1.inOut", stagger: 0.03 }, 1.35);
      // 5 — as the lines arrive, the bGEN card fades in where they converge
      tl.fromTo(bgen, { opacity: 0, y: 14, scale: 0.94 }, { opacity: 1, y: 0, scale: 1, duration: 0.55, ease: "power2.out" }, 1.85);

      // CTA — the funnel line carries on into a rounded border that draws itself
      // around the card as it scrolls in; the content fades in with it.
      const ctaCard = root.querySelector("[data-gs-cta-card]") as HTMLElement;
      const ctaPath = root.querySelector("[data-gs-cta-path]") as SVGPathElement;
      const ctaFrame = root.querySelector("[data-gs-cta-frame]") as SVGSVGElement;
      const ctaInner = root.querySelector("[data-gs-cta-inner]") as HTMLElement;
      if (ctaCard && ctaPath && ctaFrame && ctaInner) {
        const buildFrame = () => {
          const w = ctaCard.clientWidth;
          const h = ctaCard.clientHeight;
          const r = 28;
          const cx = w / 2;
          // reach the connector up exactly to the foot of the pinned scene, where the
          // strand from under the bGEN card ends — closes the gap at any size
          const docY = (el: HTMLElement) => el.getBoundingClientRect().top + window.scrollY;
          const sceneBottom = docY(scene) + scene.offsetHeight;
          const CONN = Math.max(36, Math.min(400, docY(ctaCard) - sceneBottom + 4));
          ctaFrame.setAttribute("viewBox", `0 0 ${w} ${h}`); // 1:1; connector draws above via overflow
          // down the connector to the top-centre, then clockwise around the rounded rect
          ctaPath.setAttribute(
            "d",
            `M ${cx} ${-CONN} L ${cx} 0 L ${w - r} 0 A ${r} ${r} 0 0 1 ${w} ${r} L ${w} ${h - r} A ${r} ${r} 0 0 1 ${w - r} ${h} L ${r} ${h} A ${r} ${r} 0 0 1 0 ${h - r} L 0 ${r} A ${r} ${r} 0 0 1 ${r} 0 L ${cx} 0`,
          );
          const len = ctaPath.getTotalLength();
          ctaPath.style.strokeDasharray = `${len}`;
          ctaPath.style.strokeDashoffset = `${len}`;
        };
        buildFrame();
        gsap.set(ctaInner, { opacity: 0, y: 18 });
        const ctaTl = gsap.timeline({
          scrollTrigger: {
            trigger: ctaCard,
            start: "top 82%",
            end: "top 56%",
            scrub: 0.6,
            invalidateOnRefresh: true,
            onRefresh: buildFrame, // re-measure after layout / resize
          },
        });
        ctaTl.to(ctaPath, { strokeDashoffset: 0, ease: "none", duration: 1 }, 0);
        ctaTl.to(ctaInner, { opacity: 1, y: 0, ease: "power2.out", duration: 0.6 }, 0.4);
      }
    }

    ScrollTrigger.refresh();
    window.addEventListener("resize", () => ScrollTrigger.refresh());
  }
</script>

<script>
  // Live prices: stocks from /v1/tokens, crypto from /v1/prices (both Chainlink on
  // Robinhood Chain). Patches the badge captions + the bGEN card in place — the
  // animation is untouched — and falls back to the built-in placeholders if the
  // API can't be reached.
  const API = import.meta.env.PUBLIC_API_URL as string | undefined;
  if (API) {
    // basket weights (percent) — bGEN is their weighted index, base 100 at 24h ago
    const WEIGHTS: Record<string, number> = { NVDA: 18, AAPL: 16, BTC: 16, MSFT: 15, ETH: 14, AMZN: 13, LINK: 8 };
    const fmtPx = (v: number) => (v >= 1000 ? Math.round(v).toLocaleString("en-US") : v.toFixed(2));
    const setChg = (el: Element, frac: number, arrow: boolean) => {
      const up = frac >= 0;
      const pct = (Math.abs(frac) * 100).toFixed(1);
      el.textContent = arrow ? `${up ? "▲" : "▼"} ${pct}%` : `${up ? "+" : "-"}${pct}%`;
      el.classList.toggle("cs-up", up);
      el.classList.toggle("cs-down", !up);
    };
    type Px = { value: number; chg: number | null };
    const load = async () => {
      const base = API.replace(/\/$/, "");
      const px: Record<string, Px> = {};
      try {
        const [tokens, prices] = await Promise.all([
          fetch(`${base}/v1/tokens`).then((r) => r.json()),
          fetch(`${base}/v1/prices`).then((r) => r.json()),
        ]);
        for (const t of tokens) if (t?.price) px[t.symbol] = { value: t.price.value, chg: t.price.change24h };
        for (const p of prices) px[p.symbol] = { value: p.value, chg: p.change24h };
      } catch (e) {
        console.warn("[basket] live prices unavailable", e);
        return;
      }
      for (const chip of document.querySelectorAll<HTMLElement>("[data-gs-chip]")) {
        const d = chip.dataset.sym ? px[chip.dataset.sym] : undefined;
        if (!d) continue;
        const pxEl = chip.querySelector(".gs-chip-px");
        const chgEl = chip.querySelector(".gs-chip-chg");
        if (pxEl) pxEl.textContent = `$${fmtPx(d.value)}`;
        if (chgEl && d.chg != null) setChg(chgEl, d.chg, true);
      }
      let ws = 0;
      let wc = 0;
      for (const sym in WEIGHTS) {
        const d = px[sym];
        if (d?.chg != null) {
          ws += WEIGHTS[sym];
          wc += WEIGHTS[sym] * d.chg;
        }
      }
      if (ws > 0) {
        const chg = wc / ws;
        const bpx = document.querySelector(".gs-bgen-px");
        const bchg = document.querySelector(".gs-bgen-chg");
        if (bpx) bpx.textContent = `$${(100 * (1 + chg)).toFixed(2)}`;
        if (bchg) setChg(bchg, chg, false);
      }
    };
    load();
    setInterval(load, 60000);
  }
</script>

<style is:global>
  /* pause the CSS orbit once the scroll transform takes over */
  .gs--frozen .gs-orbit-chip { animation-play-state: paused; }
</style>

<script is:inline>
  // Cover token parallax: the jade token eases toward the cursor a touch, giving
  // the cover depth. Runs on the planet wrapper (--px/--py) so the float keyframe
  // on the image is untouched. No-op under reduced motion or on coarse pointers.
  (function () {
    // set on the pin so both planet layers (base + front occluder) inherit --px/--py
    var pin = document.querySelector("[data-gs-pin]");
    if (!pin) return;
    if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    if (window.matchMedia && window.matchMedia("(pointer: coarse)").matches) return;
    var tx = 0, ty = 0, cx = 0, cy = 0, AMP = 20;
    window.addEventListener("pointermove", function (e) {
      tx = (e.clientX / window.innerWidth - 0.5) * AMP;
      ty = (e.clientY / window.innerHeight - 0.5) * AMP;
    }, { passive: true });
    (function frame() {
      cx += (tx - cx) * 0.06;
      cy += (ty - cy) * 0.06;
      pin.style.setProperty("--px", cx.toFixed(1) + "px");
      pin.style.setProperty("--py", cy.toFixed(1) + "px");
      requestAnimationFrame(frame);
    })();
  })();
</script>
