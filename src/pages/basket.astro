---
import ComingSoonLayout from "../layouts/ComingSoonLayout.astro";

// Genesis — a pinned scroll-story that builds the flagship basket. One centred
// stage: the title + a live marquee of the whole market; on scroll everything
// that isn't Genesis fades, and the seven holdings physically gather into a
// single tight row, then the stats reveal, then a full-width waitlist CTA.
// GSAP + ScrollTrigger (see <script>). Static fallback on mobile / reduced
// motion. Numbers are PLACEHOLDER until the live Chainlink island lands.

const genesis = [
  { sym: "NVDA", name: "NVIDIA", kind: "stock", weight: 18, px: "181.20", chg: 4.1 },
  { sym: "AAPL", name: "Apple", kind: "stock", weight: 16, px: "232.60", chg: 1.2 },
  { sym: "BTC", name: "Bitcoin", kind: "crypto", weight: 16, px: "95,240", chg: 2.6 },
  { sym: "MSFT", name: "Microsoft", kind: "stock", weight: 15, px: "441.10", chg: 0.9 },
  { sym: "ETH", name: "Ethereum", kind: "crypto", weight: 14, px: "3,410", chg: 5.4 },
  { sym: "AMZN", name: "Amazon", kind: "stock", weight: 13, px: "233.90", chg: 2.2 },
  { sym: "LINK", name: "Chainlink", kind: "crypto", weight: 8, px: "24.80", chg: 6.3 },
];
const others = [
  { sym: "GOOGL", name: "Alphabet", kind: "stock", px: "201.40", chg: 3.0 },
  { sym: "META", name: "Meta", kind: "stock", px: "604.50", chg: 2.7 },
  { sym: "TSLA", name: "Tesla", kind: "stock", px: "412.80", chg: -1.8 },
  { sym: "SOL", name: "Solana", kind: "crypto", px: "214.30", chg: 7.9 },
  { sym: "COIN", name: "Coinbase", kind: "stock", px: "312.10", chg: -0.6 },
  { sym: "PLTR", name: "Palantir", kind: "stock", px: "88.40", chg: 5.1 },
  { sym: "MSTR", name: "MicroStrategy", kind: "stock", px: "402.70", chg: -2.3 },
  { sym: "ORCL", name: "Oracle", kind: "stock", px: "196.20", chg: 1.4 },
  { sym: "AMD", name: "AMD", kind: "stock", px: "168.90", chg: 3.6 },
  { sym: "INTC", name: "Intel", kind: "stock", px: "42.10", chg: -1.1 },
  { sym: "MU", name: "Micron", kind: "stock", px: "112.30", chg: 2.9 },
  { sym: "CRWD", name: "CrowdStrike", kind: "stock", px: "372.50", chg: 0.8 },
];
// Interleave Genesis holdings across the market row.
const market = [
  others[0], genesis[0], others[1], others[2], genesis[1], others[3],
  genesis[2], others[4], others[5], genesis[3], others[6], genesis[4],
  others[7], others[8], genesis[5], others[9], others[10], genesis[6], others[11],
];
const isGen = (sym: string) => genesis.some((g) => g.sym === sym);
// Most stock logos are colour PNGs; a few brand marks ship as monochrome SVGs
// (the PNG set had them white-on-transparent, invisible on the light tile).
const stockSvg = new Set(["AAPL", "INTC"]);
const logoSrc = (c: { sym: string; kind: string }) =>
  c.kind === "crypto"
    ? `/logos/crypto/${c.sym.toLowerCase()}.svg`
    : `/logos/stock/${c.sym}.${stockSvg.has(c.sym) ? "svg" : "png"}`;

const stats = [
  { big: "+3.6%", label: "since launch" },
  { big: "7", label: "holdings · 4 stocks / 3 crypto" },
  { big: "1", label: "signature to own them all" },
  { big: "0.5%", label: "streaming fee at launch" },
];
---
<ComingSoonLayout
  title="Basquets — Genesis basket"
  description="Genesis: the first Basquets basket — the biggest names in stocks and crypto on Robinhood Chain, drafted into one, priced live by Chainlink."
  badges={false}
>
  <div class="gs" data-gs-root>
    <div class="gs-stagewrap" data-gs-wrap>
      <div class="gs-stage" data-gs-stage>
        <div class="gs-group" data-gs-group>
          <div class="gs-head">
            <span class="cs-tag">The flagship basket · curated by Basquets</span>
            <h1 class="cs-display gs-title">Genesis.</h1>
            <p class="gs-sub" data-gs-sub>
              Four mega-caps that already run your life: <span class="gs-asset"><i><img src="/logos/stock/NVDA.png" alt="" />
              </i>NVDA</span> <span class="gs-asset"><i><img src="/logos/stock/AAPL.svg" alt="" /></i>AAPL</span>
              <span class="gs-asset"><i><img src="/logos/stock/MSFT.png" alt="" /></i>MSFT</span>
              <span class="gs-asset"><i><img src="/logos/stock/AMZN.png" alt="" /></i>AMZN</span>. And the three
              protocols rebuilding money underneath it: <span class="gs-asset"><i><img src="/logos/crypto/btc.svg" alt="" /></i>BTC</span>
              <span class="gs-asset"><i><img src="/logos/crypto/eth.svg" alt="" /></i>ETH</span> and
              <span class="gs-asset"><i><img src="/logos/crypto/link.svg" alt="" /></i>LINK</span>, the oracle
              that prices the whole basket.
            </p>
            <p class="gs-heroline">Incumbents and insurgents, in one self-custodied token.</p>
          </div>

          <div class="gs-row" data-gs-row>
            <div class="gs-track" data-gs-track>
              {[false, true].map((dup) =>
                market.map((c) => (
                  <article class="gs-card" data-genesis={isGen(c.sym)} data-dup={dup}>
                    <div class="gs-card-head">
                      <span class="gs-logo">
                        <img src={logoSrc(c)} alt="" loading="lazy" width="28" height="28" />
                      </span>
                      <span class="gs-card-id">
                        <b class="gs-sym">{c.sym}</b>
                        <span class="gs-name">{c.name}</span>
                      </span>
                    </div>
                    <div class="gs-card-foot">
                      <span class="gs-px">${c.px}</span>
                      <span class={`gs-chg ${c.chg >= 0 ? "cs-up" : "cs-down"}`}>{c.chg >= 0 ? "▲" : "▼"} {Math.abs(c.chg)}%</span>
                    </div>
                  </article>
                )),
              )}
            </div>
          </div>
        </div>

        <!-- lines the seven funnel down into the basket token -->
        <svg class="gs-lines" data-gs-lines aria-hidden="true"></svg>

        <!-- the minted basket token, a real onchain asset -->
        <div class="gs-token" data-gs-token>
          <span class="gs-token-mark" aria-hidden="true"></span>
          <span class="gs-token-id">
            <span class="gs-token-sym">bGEN</span>
            <span class="gs-token-name">Genesis · basket token</span>
          </span>
          <span class="gs-token-val">
            <span class="gs-token-price">$103.60</span>
            <span class="cs-return-val cs-up gs-token-chg">+3.6%</span>
          </span>
        </div>

        <!-- revealed once the token is minted -->
        <div class="gs-culmination" data-gs-cul>
          <div class="gs-stats">
            {stats.map((s) => (
              <div class="gs-stat">
                <span class="gs-stat-big">{s.big}</span>
                <span class="gs-stat-label">{s.label}</span>
              </div>
            ))}
          </div>
        </div>

        <span class="gs-scrolldown" data-gs-scrolldown>Scroll down ↓</span>
      </div>
    </div>

    <!-- ACT close — CTA -->
    <section class="gs-cta">
      <span class="cs-tag">Early access</span>
      <h2 class="cs-display cs-display--sm">Own Genesis in <em>one signature.</em></h2>
      <p class="gs-cta-sub">
        Priced live by Chainlink, self-custodied, yours. Join the waitlist to draft baskets before
        anyone else.
      </p>
      <div class="cs-cta-row" style="justify-content:center;">
        <a href="/join" class="cs-pill cs-pill--ink cs-pill--lg">Join the waitlist</a>
        <a href="/" class="cs-pill cs-pill--ghost cs-pill--lg">← Back home</a>
      </div>
    </section>
  </div>
</ComingSoonLayout>

<style>
  /* pinned stage */
  .gs-stagewrap { height: 320vh; position: relative; }
  .gs-stage { height: 100vh; overflow: hidden; position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; }

  /* centred group: title + marquee row, tight together */
  .gs-group { display: flex; flex-direction: column; align-items: center; gap: clamp(28px, 5vh, 56px); width: 100%; will-change: transform; }
  .gs-head { text-align: center; padding: 0 clamp(20px, 5vw, 48px); }
  .gs-title { margin: 12px 0 0; font-size: clamp(56px, 10vw, 132px); }
  .gs-sub { max-width: 62ch; margin: 18px auto 0; font-size: clamp(16px, 1.5vw, 21px); line-height: 1.95; color: var(--ink-70); }
  /* inline asset — just the logo tile + bold name, no chrome */
  .gs-asset {
    display: inline-flex; align-items: center; gap: 6px; vertical-align: middle;
    margin: 0 2px; font-weight: 600; color: var(--ink); white-space: nowrap;
  }
  .gs-asset i {
    display: inline-flex; align-items: center; justify-content: center;
    width: 21px; height: 21px; border-radius: 6px; background: #fff;
    box-shadow: 0 1px 3px -1px color-mix(in srgb, var(--ink) 45%, transparent);
  }
  .gs-asset i img { width: 14px; height: 14px; object-fit: contain; display: block; }
  /* the payoff line, italic, one line, closing the hero */
  .gs-heroline { margin: 20px auto 0; font-family: var(--serif); font-style: italic; font-weight: 400; font-size: clamp(18px, 1.9vw, 25px); color: var(--ink-70); white-space: nowrap; }
  /* scroll hint, pinned to the bottom of the viewport */
  .gs-scrolldown { position: absolute; bottom: clamp(24px, 5vh, 54px); left: 50%; transform: translateX(-50%); font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-55); opacity: 0.7; z-index: 3; animation: gs-bob 2.4s ease-in-out infinite; }
  @keyframes gs-bob { 0%, 100% { transform: translateX(-50%) translateY(0); } 50% { transform: translateX(-50%) translateY(5px); } }

  /* the market marquee */
  .gs-row { width: 100%; overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent); mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent); }
  .gs-track { display: flex; gap: 16px; width: max-content; will-change: transform; }
  .gs-card {
    flex: 0 0 auto; width: 178px; display: flex; flex-direction: column; gap: 14px;
    padding: 16px; border-radius: 18px;
    background:
      linear-gradient(180deg, color-mix(in srgb, #fff 32%, transparent), transparent 62%),
      color-mix(in srgb, #fff 70%, var(--sand-2));
    border: 1px solid var(--line);
    box-shadow: 0 20px 40px -26px color-mix(in srgb, var(--ink) 45%, transparent);
    will-change: transform, opacity, filter;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .gs-card[data-genesis="true"] {
    border-color: color-mix(in srgb, var(--accent) 50%, transparent);
    box-shadow: 0 22px 46px -24px color-mix(in srgb, var(--accent) 46%, transparent);
    background:
      radial-gradient(120% 90% at 50% -12%, color-mix(in srgb, var(--accent) 13%, transparent), transparent 60%),
      color-mix(in srgb, #fff 72%, var(--sand-2));
  }
  .gs-card-head { display: flex; align-items: center; gap: 11px; }
  .gs-logo {
    width: 42px; height: 42px; flex: none; border-radius: 12px;
    background: #fff; border: 1px solid var(--line);
    display: grid; place-items: center; overflow: hidden;
    box-shadow: 0 2px 6px -3px color-mix(in srgb, var(--ink) 40%, transparent);
  }
  .gs-logo img { width: 28px; height: 28px; object-fit: contain; }
  .gs-card-id { display: flex; flex-direction: column; min-width: 0; }
  .gs-sym { font-weight: 700; font-size: 15px; letter-spacing: 0.01em; }
  .gs-name { font-size: 11.5px; color: var(--ink-55); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .gs-card-foot { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .gs-px { font-size: 15px; font-weight: 600; font-variant-numeric: tabular-nums; }
  .gs-chg { font-size: 11.5px; font-weight: 700; font-variant-numeric: tabular-nums; padding: 2px 7px; border-radius: 999px; }
  .gs-chg.cs-up { background: color-mix(in srgb, var(--accent) 15%, transparent); color: var(--accent-deep); }
  .gs-chg.cs-down { background: color-mix(in srgb, var(--down) 13%, transparent); color: var(--down); }

  /* the lines the seven funnel down into the token */
  .gs-lines { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 1; overflow: visible; }
  /* :global — the paths are created in JS and lack Astro's scope attribute */
  :global(.gs-line) { fill: none; stroke: var(--accent); stroke-width: 1.5; opacity: 0.5; stroke-linecap: round; }

  /* the minted basket token — a real onchain asset */
  .gs-token {
    position: absolute; left: 50%; top: 60%;
    display: inline-flex; align-items: center; gap: 14px;
    padding: 15px 22px 15px 15px; border-radius: 18px;
    background:
      radial-gradient(130% 130% at 18% 0%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 62%),
      color-mix(in srgb, #fff 80%, var(--sand-2));
    border: 1px solid color-mix(in srgb, var(--accent) 42%, transparent);
    box-shadow: 0 34px 64px -30px color-mix(in srgb, var(--accent) 52%, transparent);
    opacity: 0; z-index: 2;
  }
  .gs-token-mark { width: 42px; height: 42px; flex: none; border-radius: 12px; background: var(--accent); box-shadow: inset 0 0 0 5px color-mix(in srgb, #fff 34%, transparent); }
  .gs-token-id { display: flex; flex-direction: column; }
  .gs-token-sym { font-weight: 700; font-size: 18px; letter-spacing: 0.01em; }
  .gs-token-name { font-size: 12px; color: var(--ink-55); }
  .gs-token-val { display: flex; flex-direction: column; align-items: flex-end; margin-left: 10px; }
  .gs-token-price { font-family: var(--serif); font-size: 23px; font-weight: 500; letter-spacing: -0.01em; font-variant-numeric: tabular-nums; }
  .gs-token-chg { font-size: 14px; }

  /* stats, pinned to the bottom */
  .gs-culmination { position: absolute; left: 50%; bottom: clamp(40px, 9vh, 92px); width: min(92vw, 680px); opacity: 0; pointer-events: none; z-index: 2; }
  .gs-stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .gs-stat { padding: 16px 12px; border-radius: 14px; background: color-mix(in srgb, #fff 40%, var(--sand-2)); border: 1px solid var(--line); text-align: center; }
  .gs-stat-big { display: block; font-family: var(--serif); font-size: clamp(22px, 2.8vw, 32px); font-weight: 500; letter-spacing: -0.01em; }
  .gs-stat-label { display: block; margin-top: 4px; font-size: 11.5px; color: var(--ink-55); line-height: 1.35; }

  /* CTA */
  .gs-cta { max-width: 760px; margin: 0 auto; padding: clamp(72px, 16vh, 180px) clamp(20px, 5vw, 48px) clamp(80px, 14vh, 160px); text-align: center; }
  .gs-cta .cs-display { margin: 16px 0 0; }
  .gs-cta-sub { max-width: 46ch; margin: 18px auto 34px; font-size: clamp(15px, 1.3vw, 18px); line-height: 1.6; color: var(--ink-70); }

  /* static fallback (mobile / reduced motion) */
  .gs--static .gs-stagewrap { height: auto; }
  .gs--static .gs-stage { height: auto; overflow: visible; display: block; padding: 24px clamp(20px, 5vw, 48px) 48px; }
  .gs--static .gs-group { gap: 32px; }
  .gs--static .gs-row { overflow: visible; -webkit-mask-image: none; mask-image: none; }
  .gs--static .gs-track { flex-wrap: wrap; justify-content: center; width: auto; }
  .gs--static .gs-card[data-genesis="false"], .gs--static .gs-card[data-dup="true"] { display: none; }
  .gs--static .gs-lines, .gs--static .gs-scrolldown { display: none; }
  .gs--static .gs-heroline { white-space: normal; }
  .gs--static .gs-token { position: static; opacity: 1; margin: 32px auto 0; }
  .gs--static .gs-culmination { position: static; opacity: 1; margin: 28px auto 0; }

  @media (max-width: 720px) { .gs-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const root = document.querySelector("[data-gs-root]") as HTMLElement | null;
  if (root) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const small = window.matchMedia("(max-width: 820px)").matches;

    if (reduce || small) {
      root.classList.add("gs--static");
    } else {
      const stage = root.querySelector("[data-gs-stage]") as HTMLElement;
      const wrap = root.querySelector("[data-gs-wrap]") as HTMLElement;
      const track = root.querySelector("[data-gs-track]") as HTMLElement;
      const group = root.querySelector("[data-gs-group]") as HTMLElement;
      const head = root.querySelector(".gs-head") as HTMLElement;
      const sub = root.querySelector("[data-gs-sub]") as HTMLElement;
      const linesSvg = root.querySelector("[data-gs-lines]") as SVGSVGElement;
      const token = root.querySelector("[data-gs-token]") as HTMLElement;
      const scrolldown = root.querySelector("[data-gs-scrolldown]") as HTMLElement;
      const cul = root.querySelector("[data-gs-cul]") as HTMLElement;
      const cards = gsap.utils.toArray<HTMLElement>(".gs-card");
      // the seven that gather = first-set Genesis holdings (not the marquee duplicate)
      const gather = cards.filter((c) => c.dataset.genesis === "true" && c.dataset.dup === "false");
      const fadeOut = cards.filter((c) => c.dataset.genesis !== "true" || c.dataset.dup === "true");

      // Centre the token + stats via GSAP transforms (not CSS) so the tweens below
      // don't clobber the centring.
      gsap.set([token, cul], { xPercent: -50 });
      gsap.set(token, { yPercent: -50 });

      // Pre-create one funnel path per holding so the timeline can target them;
      // their geometry is set on freeze once positions are known.
      const linePaths: SVGPathElement[] = [];
      for (let i = 0; i < gather.length; i++) {
        const p = document.createElementNS("http://www.w3.org/2000/svg", "path");
        p.setAttribute("class", "gs-line");
        linesSvg.appendChild(p);
        linePaths.push(p);
      }

      // Seamless marquee: shift the track by exactly one card-set width and loop.
      const marquee = gsap.to(track, { x: () => -track.scrollWidth / 2, duration: 46, ease: "none", repeat: -1 });

      // The seven gather at FULL size into a row in the upper third; lines then
      // funnel down into the bGEN token. Targets measured once, marquee frozen.
      const GAP = 10;
      const ROW_Y = 0.36; // vertical centre of the gathered row (fraction of vh)
      const TOKEN_Y = 0.66; // vertical centre of the bGEN token
      const centers: number[] = [];
      let cardH = 0;
      let fitScale = 1; // shrink only enough that all seven fit the viewport width
      let groupShift = 0; // move the WHOLE group up so the row lands at ROW_Y (nothing flies out on its own)
      function computeTargets() {
        const cardW = gather[0].offsetWidth;
        cardH = gather[0].offsetHeight;
        const natural = gather.length * cardW + (gather.length - 1) * GAP;
        fitScale = Math.min(1, (window.innerWidth * 0.94) / natural);
        const spacing = (cardW + GAP) * fitScale;
        const total = gather.length * spacing - GAP * fitScale;
        const startCenter = window.innerWidth / 2 - total / 2 + (cardW * fitScale) / 2;
        const targetY = window.innerHeight * ROW_Y;
        const r0 = gather[0].getBoundingClientRect();
        groupShift = targetY - (r0.top + r0.height / 2);
        centers.length = 0;
        gather.forEach((c, i) => {
          const r = c.getBoundingClientRect();
          const cx = startCenter + i * spacing;
          centers[i] = cx;
          (c as any)._dx = cx - (r.left + r.width / 2);
        });
      }

      // Set each funnel path's geometry: from the card's underside to the token.
      function buildLines() {
        const vw = window.innerWidth;
        const vh = window.innerHeight;
        linesSvg.setAttribute("viewBox", `0 0 ${vw} ${vh}`);
        const rowBottom = vh * ROW_Y + (cardH * fitScale) / 2;
        const bx = vw / 2;
        const by = vh * TOKEN_Y - 46; // roughly the token's top edge
        linePaths.forEach((p, i) => {
          const cx = centers[i];
          p.setAttribute("d", `M ${cx} ${rowBottom} C ${cx} ${rowBottom + 90}, ${bx} ${by - 90}, ${bx} ${by}`);
          const len = p.getTotalLength();
          p.style.strokeDasharray = `${len}`;
          p.style.strokeDashoffset = `${len}`;
        });
      }

      // Freeze the marquee and lock every measured value exactly ONCE, the first
      // time the pin engages. Recomputing later (on re-enter / refresh) would
      // measure already-transformed elements and corrupt the reverse scrub.
      let frozen = false;
      function freeze() {
        marquee.pause();
        if (frozen) return;
        computeTargets();
        buildLines();
        frozen = true;
        tl.invalidate();
      }

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: wrap,
          start: "top top",
          end: "bottom bottom",
          scrub: 0.8,
          pin: stage,
          anticipatePin: 1,
          invalidateOnRefresh: true,
          onEnter: freeze,
          onEnterBack: () => marquee.pause(),
        },
      });

      gsap.set(gather, { zIndex: 3 }); // keep the seven above the crowd

      // 1 — subtitle steps aside; the bottom scroll hint fades as the build starts.
      tl.to(sub, { opacity: 0, y: -12, duration: 0.3 }, 0);
      tl.to(scrolldown, { opacity: 0, duration: 0.25 }, 0);
      // 2 — the whole row drifts up together while the seven converge horizontally.
      tl.to(group, { y: () => groupShift, duration: 1.3, ease: "power2.inOut" }, 0.15);
      tl.to(gather, { x: (i, t) => (t as any)._dx, scale: () => fitScale, duration: 1.3, ease: "power2.inOut", stagger: 0.05 }, 0.15);
      // 3 — ...and the rest of the market dissolves around them.
      tl.to(fadeOut, { opacity: 0, scale: 0.84, filter: "grayscale(1)", duration: 0.7, stagger: { each: 0.01, from: "random" } }, 0.3);
      // 4 — the title bows out to make room for the mint.
      tl.to(head, { opacity: 0, y: -24, duration: 0.4 }, 1.15);
      // 5 — the seven funnel down as lines...
      tl.to(linePaths, { strokeDashoffset: 0, duration: 0.6, ease: "power1.inOut", stagger: 0.03 }, 1.45);
      // 6 — ...minting the bGEN token...
      tl.fromTo(token, { opacity: 0, scale: 0.7, y: 14 }, { opacity: 1, scale: 1, y: 0, duration: 0.5, ease: "back.out(1.6)" }, 1.75);
      // 7 — ...and its stats.
      tl.fromTo(cul, { opacity: 0, y: 26 }, { opacity: 1, y: 0, duration: 0.5 }, 2.0);
    }

    ScrollTrigger.refresh();
    window.addEventListener("resize", () => ScrollTrigger.refresh());
  }
</script>
