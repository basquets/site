---
import ComingSoonLayout from "../layouts/ComingSoonLayout.astro";

// Coming-soon landing for the root domain. Kept intentionally clean: hero +
// waitlist only. The live demo basket lives on its own page (/basket). The
// warm theme, nav, footer and sticky ticker come from ComingSoonLayout.
---
<ComingSoonLayout
  title="Basquets — Coming soon"
  description="Tokenized US stocks and crypto, drafted into baskets on Robinhood Chain. Basquets is launching soon — join the waitlist."
  fullscreen
>
  <!-- HERO -->
  <section class="cs-hero">
    <div class="cs-hero-inner">
      <h1 class="cs-display" data-reveal style="--d:1">Draft the <em>market.</em></h1>
      <p class="cs-lead" data-reveal style="--d:2">
        Real US stocks and crypto live onchain as tokens. Basquets turns them into <strong>baskets</strong>{" "}
        — portfolios anyone can create, invest in with one signature, and automate. Priced by
        Chainlink, self-custodied.
      </p>
      <div class="cs-cta-row" data-reveal style="--d:3">
        <a href="/join" class="cs-pill cs-pill--ink cs-pill--lg">Join the waitlist</a>
        <a href="/basket" class="cs-pill cs-pill--ghost cs-pill--lg">See a live basket →</a>
      </div>
    </div>
    <div class="cs-blob" aria-hidden="true"></div>
  </section>
</ComingSoonLayout>
