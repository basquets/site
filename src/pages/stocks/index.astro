---
import MarketOverview from "../../components/islands/MarketOverview";
import StockTable from "../../components/islands/StockTable";
import Container from "../../components/layout/Container.astro";
import CTABanner from "../../components/layout/CTABanner.astro";
import Kicker from "../../components/layout/Kicker.astro";
import Section from "../../components/layout/Section.astro";
import { buttonVariants } from "../../components/ui/button";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { BLOCKSCOUT, CORE_CONTRACTS, TOKENS } from "../../lib/tokens";
import { cn } from "../../lib/utils";
---
<BaseLayout
  title="Stock token dashboard - Basquets"
  description="Every Robinhood stock token on one page: live price, tokens outstanding, onchain market cap, holders and Uniswap v4 depth, each labelled with where the number came from."
>
  <main id="main">
    <!-- the same ink plate the homepage shelf sits on: this page is that
         section, opened out. -->
    <section class="slab relative overflow-hidden bg-ink pt-[calc(2.5*28px)] pb-[calc(2.5*28px)] text-ground">
      <Container class="relative z-10">
        <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-3">
          <span class="block text-[11px] uppercase tracking-[0.1em] text-accent-300">The shelf</span>
          <span class="text-[11px] uppercase tracking-[0.1em] text-ground/60">Chain 4663</span>
        </div>
        <h1 class="mt-4 mb-0 -ml-[0.058em] text-[clamp(38px,5vw,68px)] leading-[1.06] tracking-[-0.02em] text-ground">
          <span class="block">Every stock token</span>
          <span class="block">on Robinhood Chain.</span>
        </h1>
        <p class="mt-8 mb-0 max-w-[58ch] text-[17px] leading-7 text-ground/70">
          Real US stocks and ETFs, tokenized by Robinhood. This page shows what is actually onchain:
          how many tokens exist, who holds them, how much sits in Uniswap pools, and what each one is
          worth — with the source of every price named, because <a
            href="/blog/verifying-price-sources"
            class="text-accent-300">not every source agrees</a>.
        </p>
        <h2 class="sr-only">Market overview</h2>
        <div class="mt-12">
          <MarketOverview tone="dark" client:load />
        </div>
      </Container>
    </section>

    <Container>
      <Section class="pt-[calc(2.5*28px)] pb-[calc(3*28px)]">
        <h2 class="sr-only">All stock tokens</h2>
        <StockTable client:load />
        <div class="mt-6 flex flex-col gap-2 text-[11px] leading-5 text-ink/55">
          <p class="m-0">
            Tokens outstanding, Uniswap pool balances and pool prices are read directly from chain 4663.
            Holder counts are indexed by <a href={BLOCKSCOUT} target="_blank" rel="noopener" class="text-accent-700">Blockscout</a>.
            Prices come from Chainlink where a feed exists; a <span class="uppercase tracking-[0.06em]">pool</span> tag
            means the price is Uniswap v4 spot instead, and a blank price means we have neither.
          </p>
          <p class="m-0">
            Onchain market cap is tokens outstanding times price. It is not the market cap of the
            underlying company — it is how much of that company has been tokenized, which is a much
            smaller and far more interesting number.
          </p>
        </div>
      </Section>

      <Section class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,420px),1fr))] gap-y-7 gap-x-[clamp(24px,5vw,96px)] pb-[calc(3*28px)]">
        <div>
          <Kicker class="mb-3.5">Before you buy</Kicker>
          <h2 class="m-0 text-[32px] leading-[42px] tracking-[-0.015em]">Only the canonical ones.</h2>
          <p class="mt-5.5 mb-0 max-w-[48ch] text-[15.5px] leading-7 text-ink/78">
            A token with a matching name or ticker but a different contract address is not a
            Robinhood stock token. Basquets only ever mints from this registry, so a basket cannot
            contain a counterfeit. If you are buying directly
            instead, <a href="/docs/getting-stock-tokens" class="text-accent-700">read this first</a> — eligibility,
            venues, and the four checks worth making.
          </p>
        </div>
        <div class="flex flex-col gap-5 tnum">
          {CORE_CONTRACTS.map((c) => (
            <div class="border-l-2 border-divider pl-5">
              <p class="m-0 mb-1 font-heading font-extrabold text-[15px]">{c.name}</p>
              <a
                href={`${BLOCKSCOUT}/address/${c.address}`}
                target="_blank"
                rel="noopener"
                class="break-all text-[12.5px] text-accent-700"
              >{c.address}</a>
            </div>
          ))}
        </div>
      </Section>
    </Container>

    <CTABanner lines={[`${TOKENS.length} ingredients are here.`, "Bring the recipe."]}>
      <a href="/baskets" class={cn(buttonVariants({ variant: "inverse" }))}>Explore baskets</a>
      <a href="/docs/stock-tokens" class={cn(buttonVariants({ variant: "inverse" }), "border-transparent")}>What is a stock token?</a>
    </CTABanner>
  </main>
</BaseLayout>
