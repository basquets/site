---
import HoldingBaskets from "../../components/islands/HoldingBaskets";
import TokenFacts from "../../components/islands/TokenFacts";
import TokenHero from "../../components/islands/TokenHero";
import Container from "../../components/layout/Container.astro";
import Kicker from "../../components/layout/Kicker.astro";
import Section from "../../components/layout/Section.astro";
import { buttonVariants } from "../../components/ui/button";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { TOKENS, type TokenInfo } from "../../lib/tokens";
import { cn } from "../../lib/utils";

export function getStaticPaths() {
  return TOKENS.map((token) => ({
    params: { sym: token.sym.toLowerCase() },
    props: { token },
  }));
}

interface Props {
  token: TokenInfo;
}
const { token } = Astro.props;
const kind = token.sector === "ETF" ? "fund" : "stock";

const ROUTES = [
  {
    name: "The Robinhood app",
    detail:
      "Buy in an eligible country, then withdraw to a self-custody wallet. The simplest route, and the only one that starts in fiat.",
    href: "/docs/getting-stock-tokens",
    cta: "Eligibility and steps",
    art: "fiat",
  },
  {
    name: "The swap desk here",
    detail: `Uniswap v4 pools and 0x market makers quoted side by side; the better price fills. USDG in, ${token.sym} out, minimum enforced onchain.`,
    href: "/swap",
    cta: `Swap ${token.sym}`,
    art: "venues",
  },
  {
    name: "A basket",
    detail: `Hold ${token.sym} as part of a recipe instead of buying it alone: one routed transaction, one position to manage.`,
    href: "/baskets",
    cta: "Explore baskets",
    art: "basket",
  },
];
---
<BaseLayout
  title={`${token.sym} stock token - Basquets`}
  description={`${token.name} on Robinhood Chain: live price, tokens outstanding, holders, Uniswap depth, and where the ${token.sym} stock token can actually be bought.`}
>
  <main id="main">
    <Container>
      <Section class="pt-[calc(2*28px)] pb-[calc(2*28px)]">
        <a href="/stocks" class="text-[13px] uppercase tracking-[0.08em] text-accent-700 no-underline hover:underline">← All stock tokens</a>
        <TokenHero sym={token.sym} client:load />
      </Section>

      <!-- the trade door: the one action this page can hand straight to the product -->
      <div class="mb-[calc(1.5*28px)] flex flex-wrap items-center justify-between gap-x-10 gap-y-5 border-2 border-ink bg-accent p-[clamp(20px,2.5vw,32px)] text-ground shadow-lg">
        <div>
          <p class="m-0 font-heading font-extrabold text-[clamp(20px,2.2vw,28px)] leading-[1.15] tracking-[-0.015em]">
            Two venues bid on every {token.sym} swap.
          </p>
          <p class="mt-1.5 mb-0 text-[14.5px] leading-6 text-ground/85">
            Uniswap v4 and 0x market makers, quoted live. You take the better one.
          </p>
        </div>
        <a href="/swap" class={cn(buttonVariants({ variant: "inverse", size: "lg" }))}>Swap {token.sym}</a>
      </div>

      <Section rule class="py-[calc(2*28px)]">
        <h2 class="m-0 mb-8 text-[clamp(24px,2.4vw,32px)] tracking-[-0.015em]">What is onchain.</h2>
        <TokenFacts sym={token.sym} client:load />
      </Section>

      <Section rule class="pt-[calc(2.5*28px)] pb-[calc(3*28px)]">
        <Kicker class="mb-3.5">Getting some</Kicker>
        <h2 class="m-0 text-[32px] leading-[42px] tracking-[-0.015em]">Three ways in.</h2>
        <p class="mt-5 mb-8 max-w-[62ch] text-[15.5px] leading-7 text-ink/78">
          You cannot mint {token.sym}: the primary market is open only to Authorized Participants.
          Every retail route is a purchase on the secondary market. Eligibility rules apply and
          exclude several countries; <a href="/docs/getting-stock-tokens" class="text-accent-700">check them first</a>.
        </p>
        <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] border-t-2 border-l-2 border-divider">
          {ROUTES.map((r) => (
            <a href={r.href} class="group flex flex-col border-r-2 border-b-2 border-divider p-6 text-ink no-underline hover:bg-surface">
              <span class="flex h-14 items-center gap-3" aria-hidden="true">
                {r.art === "fiat" && (
                  <>
                    <span class="flex size-9 items-center justify-center border-2 border-ink font-heading font-extrabold text-[15px]">$</span>
                    <span class="relative h-0.5 w-10 bg-ink">
                      <span class="absolute -top-1 -right-px border-y-[5px] border-l-8 border-y-transparent border-l-ink"></span>
                    </span>
                    <span class="size-9 bg-accent"></span>
                  </>
                )}
                {r.art === "venues" && (
                  <>
                    <span class="flex flex-col gap-1.5">
                      <span class="size-4 bg-accent"></span>
                      <span class="size-4 border-2 border-neutral-500"></span>
                    </span>
                    <span class="relative h-0.5 w-10 bg-ink">
                      <span class="absolute -top-1 -right-px border-y-[5px] border-l-8 border-y-transparent border-l-ink"></span>
                    </span>
                    <span class="size-9 bg-accent"></span>
                  </>
                )}
                {r.art === "basket" && (
                  <span class="flex size-12 items-center justify-center border-2 border-ink">
                    <span class="grid grid-cols-3 gap-1">
                      <span class="size-2 bg-neutral-300"></span>
                      <span class="size-2 bg-neutral-300"></span>
                      <span class="size-2 bg-neutral-300"></span>
                      <span class="size-2 bg-neutral-300"></span>
                      <span class="size-2 bg-accent"></span>
                      <span class="size-2 bg-neutral-300"></span>
                      <span class="size-2 bg-neutral-300"></span>
                      <span class="size-2 bg-neutral-300"></span>
                      <span class="size-2 bg-neutral-300"></span>
                    </span>
                  </span>
                )}
              </span>
              <span class="mt-3 font-heading font-extrabold text-[16px]">{r.name}</span>
              <p class="mt-2 mb-0 text-[14.5px] leading-6 text-ink/75">{r.detail}</p>
              <span class="mt-auto flex items-center gap-2 pt-4 font-heading font-extrabold text-[13.5px] text-accent-700">
                {r.cta}
                <span class="transition-transform duration-150 group-hover:translate-x-1" aria-hidden="true">→</span>
              </span>
            </a>
          ))}
        </div>
      </Section>

      <Section rule class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,420px),1fr))] gap-y-10 gap-x-[clamp(24px,5vw,96px)] pt-[calc(2.5*28px)] pb-[calc(3*28px)]">
        <div>
          <h2 class="m-0 text-[32px] leading-[42px] tracking-[-0.015em]">A price, not a share.</h2>
          <p class="mt-5.5 mb-0 max-w-[48ch] text-[15.5px] leading-7 text-ink/78">
            {token.sym} tracks the underlying US-listed {kind} but does not convey ownership of it.
            It is a tokenised debt security issued by Robinhood Assets (Jersey) Limited, and it
            transfers like any ERC-20: nights, weekends, holidays. When US markets close the oracle
            freezes; your tokens keep moving. <a href="/docs/stock-tokens" class="text-accent-700">The full mechanics</a> are
            worth ten minutes.
          </p>
          <!-- the token, not the certificate -->
          <div class="mt-9 hidden items-center gap-5 sm:flex" aria-hidden="true">
            <span class="flex size-14 items-center justify-center bg-accent font-heading font-extrabold text-[18px] text-ground">{token.sym.slice(0, 1)}</span>
            <span class="font-heading font-extrabold text-[22px] text-ink/45">≠</span>
            <span class="flex h-[72px] w-14 flex-col justify-center gap-1.5 border-2 border-neutral-400 px-2.5 opacity-60">
              <span class="h-0.5 w-full bg-neutral-400"></span>
              <span class="h-0.5 w-full bg-neutral-400"></span>
              <span class="h-0.5 w-3/4 bg-neutral-400"></span>
            </span>
            <span class="max-w-[18ch] text-[12px] leading-5 text-ink/55">The token in your wallet, not the certificate in a vault.</span>
          </div>
        </div>
        <div class="flex flex-col divide-y-2 divide-divider text-[14.5px] leading-6">
          {[
            ["Issuer", "Robinhood Assets (Jersey) Limited"],
            ["You own", "Economic exposure. No voting rights, no legal title"],
            ["Pricing", "Chainlink oracle during market hours; frozen at close"],
            ["Custody", "Yours: a wallet, not an account"],
            ["Corporate actions", "Applied as a multiplier; your raw balance never changes"],
          ].map(([term, def]) => (
            <div class="flex gap-4 py-4">
              <span class="min-w-[130px] font-heading font-extrabold">{term}</span>
              <span class="text-ink/78">{def}</span>
            </div>
          ))}
        </div>
      </Section>
    </Container>

    <!-- the baskets that hold this token, on the house ink plate: the page's closing word -->
    <section class="slab relative overflow-hidden bg-ink py-[calc(2.5*28px)] text-ground">
      <Container class="relative z-10">
        <h2 class="m-0 mb-9 max-w-[20ch] text-[clamp(28px,3.2vw,44px)] leading-[1.1] tracking-[-0.02em] text-ground">Baskets holding {token.sym}.</h2>
        <HoldingBaskets sym={token.sym} onInk client:load />
        <div class="mt-12 flex flex-wrap items-center justify-between gap-x-10 gap-y-6 border-t-2 border-ground/25 pt-8">
          <p class="m-0 font-heading font-extrabold text-[clamp(20px,2.4vw,30px)] leading-[1.15] tracking-[-0.015em] text-ground">
            {token.sym} is one ingredient. Write the recipe.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="/curators" class={cn(buttonVariants({ variant: "inverse", size: "lg" }))}>Create a basket</a>
            <a href="/baskets" class={cn(buttonVariants({ variant: "inverse", size: "lg" }), "border-transparent")}>Explore baskets</a>
          </div>
        </div>
      </Container>
    </section>
  </main>
</BaseLayout>
